"""The crypto group of the post-boot feature tests (REQ_PBF_10, 11, 12, 15); see BUILD.

Each entry: name (the source is <name>.c), deps (beyond the common ones in BUILD), secure_boot
(also built behind ROM_EXT, exec env sim_dv_rom_ext), modes ("" RISC-V, "cheriot"; default both),
srcs (sources it shares with its group).

The group's shared sources: eg2_pbf_crypto.{c,h} (engines, the software CTR_DRBG reference, the
key manager, the escalation) and eg2_pbf_crypto_kat.h (NIST values, generated by
gen_pbf_crypto_kat.py from the pinned CAVP files).
"""

_SRCS = [
    "eg2_pbf_crypto.c",
    "eg2_pbf_crypto.h",
    "eg2_pbf_crypto_kat.h",
]

_DEPS = [
    "//hw/top:aes_c_regs",
    "//hw/top:alert_handler_c_regs",
    "//hw/top:hmac_c_regs",
    "//hw/top:keymgr_dpe_c_regs",
    "//hw/top:kmac_c_regs",
    "//hw/top:rstmgr_c_regs",
    "//sw/device/lib/base:bitfield",
    "//sw/device/lib/base:mmio",
    "//sw/device/lib/dif:aes",
    "//sw/device/lib/dif:keymgr_dpe",
    "//sw/device/lib/dif:kmac",
    "//sw/device/lib/dif:rstmgr",
    "//sw/device/lib/testing:entropy_testutils",
    "//sw/device/lib/testing:keymgr_dpe_testutils",
    "//sw/device/lib/testing:kmac_testutils",
    "//sw/device/tests/eg2_nist:eg2_nist_sha2_engine",
]

_OTBN_SRCS = _SRCS + [
    "eg2_pbf_otbn.c",
    "eg2_pbf_otbn.h",
]

_OTBN_DEPS = [
    "//hw/top:otbn_c_regs",
    "//sw/device/lib/crypto/impl/ecc:p256",
]

_ENTROPY_DEPS = [
    "//hw/top:csrng_c_regs",
    "//hw/top:edn_c_regs",
    "//hw/top:entropy_src_c_regs",
    "//sw/device/lib/dif:csrng",
    "//sw/device/lib/dif:csrng_shared",
    "//sw/device/lib/dif:edn",
    "//sw/device/lib/dif:entropy_src",
]

CRYPTO_TESTS = [
    {"name": "eg2_pbf_sym_crypto_sb", "deps": _DEPS, "srcs": _SRCS, "secure_boot": True},
    {"name": "eg2_pbf_sym_crypto_fault", "deps": _DEPS, "srcs": _SRCS},
    # RISC-V mode only for now: the OTBN program's embedded object (rules/otbn.bzl rv32embed, e.g.
    # librun_p256.rv32embed.a) is built with ELF flags 0x0, and ld.lld refuses it next to the
    # CHERIoT objects (flags 0x70009: cheriabi, capability mode, cheriot). The `_cheriot` builds
    # need an rv32embed for the CHERIoT ABI (a rules/otbn.bzl change, not this area's).
    {"name": "eg2_pbf_otbn_sb", "deps": _DEPS + _OTBN_DEPS, "srcs": _OTBN_SRCS, "secure_boot": True, "modes": [""]},
    {"name": "eg2_pbf_otbn_fault", "deps": _DEPS + _OTBN_DEPS, "srcs": _OTBN_SRCS, "modes": [""]},
    {"name": "eg2_pbf_entropy_sb", "deps": _DEPS + _ENTROPY_DEPS, "srcs": _SRCS, "secure_boot": True},
    {"name": "eg2_pbf_entropy_fault", "deps": _DEPS + _ENTROPY_DEPS, "srcs": _SRCS},
    {"name": "eg2_pbf_keymgr_sb", "deps": _DEPS, "srcs": _SRCS, "secure_boot": True},
    {"name": "eg2_pbf_keymgr_fault", "deps": _DEPS, "srcs": _SRCS},
]
