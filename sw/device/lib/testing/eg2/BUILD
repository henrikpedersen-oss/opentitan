# The EG2 test framework (eg2_top_verification, doc/eg2_test_framework.md): one test source,
# built for RISC-V mode (OTTF) and for CHERIoT mode (platform CHERIOT_PLATFORM, the start-up
# code in cheriot/). A test depends on `:test` alone.

package(default_visibility = ["//visibility:public"])

# Generated by eg2_top_verification/scripts/gen_eg2_tables.py.
cc_library(
    name = "tables",
    hdrs = ["eg2_tables.h"],
    deps = ["//hw/top:top_lib"],
)

cc_library(
    name = "dev",
    srcs = [
        "eg2_dev.c",
        "eg2_mmio.c",
    ],
    hdrs = ["eg2_dev.h"],
    deps = [
        ":tables",
        "//sw/device/lib/base:mmio",
    ],
)

# The console, the verdict and the status sweep call each other, so they are one library.
cc_library(
    name = "status",
    srcs = [
        "eg2_result.c",
        "eg2_status.c",
    ],
    hdrs = [
        "eg2_result.h",
        "eg2_status.h",
    ],
    deps = [
        ":dev",
        "//hw/top:alert_handler_c_regs",
        "//hw/top:gpio_c_regs",
        "//hw/top:rstmgr_c_regs",
        "//hw/top:rv_core_ibex_c_regs",
        "//hw/top:uart_c_regs",
        "//sw/device/lib/arch:device",
        "//sw/device/lib/base:multibits",
    ],
)

cc_library(
    name = "cheriot_crt",
    srcs = [
        "cheriot/eg2_cheriot_main.c",
        "cheriot/eg2_cheriot_start.S",
    ],
    target_compatible_with = ["//toolchain:isa_cheriot"],
    deps = [
        ":status",
        "//hw/top:rv_core_ibex_c_regs",
        "//hw/top:sram_ctrl_c_regs",
        "//hw/top:top_lib",
        "//hw/top:uart_c_regs",
        "//sw/device/lib/base:multibits",
        "//sw/device/silicon_creator/lib:manifest_def",
    ],
    alwayslink = True,
)

cc_library(
    name = "params",
    srcs = ["eg2_params.c"],
    hdrs = ["eg2_params.h"],
    deps = [
        ":status",
        "//sw/device/lib/base:macros",
    ],
)

# The framework's test_main: parameters, status, the test's eg2_test_main, the final sweep.
cc_library(
    name = "test",
    srcs = ["eg2_test.c"],
    hdrs = ["eg2_test.h"],
    alwayslink = True,
    deps = [
        ":params",
        ":status",
    ] + select({
        "//toolchain:isa_cheriot": [":cheriot_crt"],
        "//conditions:default": [
            "//sw/device/lib/testing/test_framework:ottf_main",
            "//sw/device/lib/testing/test_framework:ottf_test_config",
        ],
    }),
)
