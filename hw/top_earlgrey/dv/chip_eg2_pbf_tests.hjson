//
// EG2 post-boot feature area (eg2_top_verification: status/test_writing_rules.md; spec REQ_PBF,
// "Post-boot features in CHERIoT mode", "Post-boot faults"). Software in sw/device/tests/eg2_pbf/,
// vseqs in env/seq_lib/chip_eg2_pbf_vseq_list.sv. The peripheral pair (REQ_PBF_13) is in
// chip_eg2_periph_tests.hjson; the debug pair (REQ_PBF_20) belongs to the debug area.
//
// Each `_sb` test runs behind the full secure-boot chain (ROM, ROM_EXT, the test as a signed owner
// image: run mode sw_test_mode_mask_rom, image flag `rom_ext`); a signed image keeps its knobs'
// defaults, so `_sb_direct` runs the same image from the test ROM with the vseq's random knobs.
// The `_fault` tests run in build mode en_eg2_periph, which builds in the injection registry: the
// vseq announces each deliberate fault there. Every `_inject_fail` run must FAIL (REQ_STE_03:
// Makefile MUST_FAIL_TESTS) and is in no regression.

{
  tests: [
    {
      name: chip_sw_eg2_pbf_sym_crypto_sb
      uvm_test_seq: chip_sw_eg2_pbf_sym_crypto_sb_vseq
      sw_images: ["//sw/device/tests/eg2_pbf:eg2_pbf_sym_crypto_sb:1:rom_ext"]
      en_run_modes: ["sw_test_mode_mask_rom"]
      build_mode: "en_eg2_cosim"
      run_opts: ["+sw_test_timeout_ns=200_000_000", "+eg2_closes=chip_sw_eg2_pbf_sym_crypto_sb:REQ_PBF_10,REQ_PBF_01"]
      run_timeout_mins: 480
    }
