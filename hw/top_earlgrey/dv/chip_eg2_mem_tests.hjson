      build_mode: "en_eg2_cosim"
      run_opts: ["+sw_test_timeout_ns=200_000_000"]
      run_timeout_mins: 480
    }
    // REQ_OTP_02: CHERIoT mode only (the RISC-V mode test is the legacy
    // chip_sw_sram_ctrl_scrambled_access, whose run options it takes: the re-keyed words fail
    // their integrity on purpose). The `_inject_fail` run must fail with `MEM FAIL`.
    {
      name: chip_sw_sram_ctrl_scrambled_access_cheriot
      uvm_test_seq: chip_sw_eg2_sram_scrambled_access_cheriot_vseq
      sw_images: ["//sw/device/tests/eg2_mem:eg2_sram_scrambled_access_cheriot:1:new_rules"]
      en_run_modes: ["sw_test_mode_test_rom"]
      build_mode: "en_eg2_cosim"
      run_opts: ["+sw_test_timeout_ns=100_000_000", "+en_scb_tl_err_chk=0",
                 "+bypass_alert_ready_to_end_check=1"]
      run_timeout_mins: 480
    }
    {
      name: chip_sw_sram_ctrl_scrambled_access_cheriot_inject_fail
