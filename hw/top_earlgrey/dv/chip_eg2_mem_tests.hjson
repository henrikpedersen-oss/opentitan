    // REQ_CMS_14, REQ_SEC_18: chip_sw_sram_lc_escalation on sram_ctrl_meta. The `_inject_fail`
    // runs must fail with `EG2 MEM metaesc: boot 1 failed 1 check(s)`.
    {
      name: chip_sw_sram_ctrl_meta_lc_escalation
      uvm_test_seq: chip_sw_eg2_sram_ctrl_meta_lc_escalation_vseq
      sw_images: ["//sw/device/tests/eg2_mem:eg2_sram_ctrl_meta_lc_escalation:1:new_rules"]
