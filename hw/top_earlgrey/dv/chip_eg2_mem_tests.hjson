//
// EG2 mem area (eg2_top_verification: status/test_writing_rules.md; spec REQ_OTP, REQ_SRAM, REQ_CMS_14, REQ_PBF_11/15/18/19).
// Software in sw/device/tests/eg2_mem/, sequences in env/seq_lib/ (chip_eg2_mem_vseq_list.sv).
// Each test runs in both modes (`_cheriot`); every `_inject_fail` run must FAIL (REQ_STE_03:
// Makefile MUST_FAIL_TESTS) and is in no regression list.
{
  tests: [
    {
      name: chip_sw_sram_ctrl_meta
      uvm_test_seq: chip_sw_eg2_sram_ctrl_meta_vseq
      sw_images: ["//sw/device/tests/eg2_mem:eg2_sram_ctrl_meta:1:new_rules"]
      en_run_modes: ["sw_test_mode_test_rom"]
      build_mode: "en_eg2_cosim"
      run_opts: ["+sw_test_timeout_ns=200_000_000"]
      run_timeout_mins: 480
    }
    {
      name: chip_sw_sram_ctrl_meta_inject_fail
      uvm_test_seq: chip_sw_eg2_sram_ctrl_meta_vseq
      sw_images: ["//sw/device/tests/eg2_mem:eg2_sram_ctrl_meta_inject_fail:1:new_rules"]
      en_run_modes: ["sw_test_mode_test_rom"]
      build_mode: "en_eg2_cosim"
      run_opts: ["+sw_test_timeout_ns=200_000_000"]
      run_timeout_mins: 480
    }
    {
      name: chip_sw_sram_ctrl_meta_cheriot
