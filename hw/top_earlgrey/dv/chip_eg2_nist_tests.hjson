//
// EG2 NIST CAVP chip tests (eg2_top_verification spec "NIST CAVP Test Suite", REQ_PBF_23), the
// ones beyond the six engine tests of chip_smoketests.hjson (regression eg2_nist): AES key wrap
// through the crypto library, ECDSA, ECDH and RSA on OTBN, and the weekly runs (Monte Carlo
// vectors, RSA signing). Software in sw/device/tests/eg2_nist/ (vector tables generated from the
// pinned CAVP archives), vseq chip_sw_eg2_nist_vseq (env/seq_lib/chip_eg2_nist_vseq_list.sv),
// which writes the knobs of the test `+eg2_nist=<test>` names. The OTBN tests are RISC-V mode
// only (the CHERIoT linker refuses the OTBN programs' embedded objects: sw/device/tests/eg2_nist/
// BUILD). Every `_inject_fail` run must FAIL (Makefile MUST_FAIL_TESTS) and is in no regression.

{
  tests: [
    {
      name: chip_sw_eg2_nist_aes_kw
      uvm_test_seq: chip_sw_eg2_nist_vseq
      sw_images: ["//sw/device/tests/eg2_nist:eg2_nist_aes_kw:1:new_rules"]
      en_run_modes: ["sw_test_mode_test_rom"]
      build_mode: "en_eg2_cosim"
      run_opts: ["+sw_test_timeout_ns=200_000_000", "+eg2_nist=aes_kw", "+eg2_closes=chip_sw_eg2_nist_aes_kw:REQ_PBF_23,REQ_PBF_10"]
      run_timeout_mins: 720
    }
    {
      name: chip_sw_eg2_nist_aes_kw_inject_fail
      uvm_test_seq: chip_sw_eg2_nist_vseq
      sw_images: ["//sw/device/tests/eg2_nist:eg2_nist_aes_kw_inject_fail:1:new_rules"]
      en_run_modes: ["sw_test_mode_test_rom"]
      build_mode: "en_eg2_cosim"
      run_opts: ["+sw_test_timeout_ns=200_000_000", "+eg2_nist=aes_kw", "+eg2_closes=chip_sw_eg2_nist_aes_kw:REQ_PBF_23,REQ_PBF_10"]
      run_timeout_mins: 480
    }
    {
      name: chip_sw_eg2_nist_aes_kw_cheriot
      uvm_test_seq: chip_sw_eg2_nist_vseq
      sw_images: ["//sw/device/tests/eg2_nist:eg2_nist_aes_kw_cheriot:1:new_rules"]
      en_run_modes: ["sw_test_mode_test_rom"]
      build_mode: "en_eg2_cosim"
      run_opts: ["+sw_test_timeout_ns=200_000_000", "+eg2_nist=aes_kw", "+eg2_closes=chip_sw_eg2_nist_aes_kw:REQ_PBF_23,REQ_PBF_10"]
      run_timeout_mins: 720
    }
    {
      name: chip_sw_eg2_nist_aes_kw_cheriot_inject_fail
      uvm_test_seq: chip_sw_eg2_nist_vseq
      sw_images: ["//sw/device/tests/eg2_nist:eg2_nist_aes_kw_cheriot_inject_fail:1:new_rules"]
      en_run_modes: ["sw_test_mode_test_rom"]
      build_mode: "en_eg2_cosim"
      run_opts: ["+sw_test_timeout_ns=200_000_000", "+eg2_nist=aes_kw", "+eg2_closes=chip_sw_eg2_nist_aes_kw:REQ_PBF_23,REQ_PBF_10"]
      run_timeout_mins: 480
    }
    {
      name: chip_sw_eg2_nist_otbn_ecdsa
      uvm_test_seq: chip_sw_eg2_nist_vseq
      sw_images: ["//sw/device/tests/eg2_nist:eg2_nist_otbn_ecdsa:1:new_rules"]
      en_run_modes: ["sw_test_mode_test_rom"]
      build_mode: "en_eg2_cosim"
      run_opts: ["+sw_test_timeout_ns=400_000_000", "+eg2_nist=otbn_ecdsa", "+eg2_closes=chip_sw_eg2_nist_otbn_ecdsa:REQ_PBF_23,REQ_PBF_11"]
      run_timeout_mins: 960
    }
    {
      name: chip_sw_eg2_nist_otbn_ecdsa_inject_fail
      uvm_test_seq: chip_sw_eg2_nist_vseq
      sw_images: ["//sw/device/tests/eg2_nist:eg2_nist_otbn_ecdsa_inject_fail:1:new_rules"]
      en_run_modes: ["sw_test_mode_test_rom"]
      build_mode: "en_eg2_cosim"
      run_opts: ["+sw_test_timeout_ns=400_000_000", "+eg2_nist=otbn_ecdsa", "+eg2_closes=chip_sw_eg2_nist_otbn_ecdsa:REQ_PBF_23,REQ_PBF_11"]
      run_timeout_mins: 480
    }
    {
      name: chip_sw_eg2_nist_otbn_ecdh
      uvm_test_seq: chip_sw_eg2_nist_vseq
      sw_images: ["//sw/device/tests/eg2_nist:eg2_nist_otbn_ecdh:1:new_rules"]
      en_run_modes: ["sw_test_mode_test_rom"]
      build_mode: "en_eg2_cosim"
      run_opts: ["+sw_test_timeout_ns=400_000_000", "+eg2_nist=otbn_ecdh", "+eg2_closes=chip_sw_eg2_nist_otbn_ecdh:REQ_PBF_23,REQ_PBF_11"]
      run_timeout_mins: 960
    }
    {
      name: chip_sw_eg2_nist_otbn_ecdh_inject_fail
      uvm_test_seq: chip_sw_eg2_nist_vseq
      sw_images: ["//sw/device/tests/eg2_nist:eg2_nist_otbn_ecdh_inject_fail:1:new_rules"]
      en_run_modes: ["sw_test_mode_test_rom"]
      build_mode: "en_eg2_cosim"
      run_opts: ["+sw_test_timeout_ns=400_000_000", "+eg2_nist=otbn_ecdh", "+eg2_closes=chip_sw_eg2_nist_otbn_ecdh:REQ_PBF_23,REQ_PBF_11"]
      run_timeout_mins: 480
    }
    {
      name: chip_sw_eg2_nist_otbn_rsa
      uvm_test_seq: chip_sw_eg2_nist_vseq
      sw_images: ["//sw/device/tests/eg2_nist:eg2_nist_otbn_rsa:1:new_rules"]
      en_run_modes: ["sw_test_mode_test_rom"]
      build_mode: "en_eg2_cosim"
      run_opts: ["+sw_test_timeout_ns=400_000_000", "+eg2_nist=otbn_rsa", "+eg2_closes=chip_sw_eg2_nist_otbn_rsa:REQ_PBF_23,REQ_PBF_11"]
      run_timeout_mins: 960
    }
    {
      name: chip_sw_eg2_nist_otbn_rsa_inject_fail
      uvm_test_seq: chip_sw_eg2_nist_vseq
      sw_images: ["//sw/device/tests/eg2_nist:eg2_nist_otbn_rsa_inject_fail:1:new_rules"]
      en_run_modes: ["sw_test_mode_test_rom"]
      build_mode: "en_eg2_cosim"
      run_opts: ["+sw_test_timeout_ns=400_000_000", "+eg2_nist=otbn_rsa", "+eg2_closes=chip_sw_eg2_nist_otbn_rsa:REQ_PBF_23,REQ_PBF_11"]
      run_timeout_mins: 480
    }
    {
      // RSA SigGen15 (MODEXP_DE, 16.5 million OTBN instructions per 2048-bit signature): weekly.
      name: chip_sw_eg2_nist_otbn_rsa_sign
      uvm_test_seq: chip_sw_eg2_nist_vseq
      sw_images: ["//sw/device/tests/eg2_nist:eg2_nist_otbn_rsa:1:new_rules"]
      en_run_modes: ["sw_test_mode_test_rom"]
      build_mode: "en_eg2_cosim"
      run_opts: ["+sw_test_timeout_ns=2_000_000_000", "+eg2_nist=otbn_rsa", "+eg2_closes=chip_sw_eg2_nist_otbn_rsa:REQ_PBF_23,REQ_PBF_11", "+eg2_param_sign=1"]
      run_timeout_mins: 1440
    }
    {
      // The Monte Carlo vectors (1000 chained operations each): weekly.
      name: chip_sw_eg2_nist_sha2_monte
      uvm_test_seq: chip_sw_eg2_nist_vseq
      sw_images: ["//sw/device/tests/eg2_nist:eg2_nist_sha2:1:new_rules"]
      en_run_modes: ["sw_test_mode_test_rom"]
      build_mode: "en_eg2_cosim"
      run_opts: ["+sw_test_timeout_ns=2_000_000_000", "+eg2_nist=sha2", "+eg2_closes=chip_sw_eg2_nist_sha2:REQ_PBF_23,REQ_PBF_10", "+eg2_param_monte=1"]
      run_timeout_mins: 1440
    }
    {
      // The Monte Carlo vectors (1000 chained operations each): weekly.
      name: chip_sw_eg2_nist_sha2_cheriot_monte
      uvm_test_seq: chip_sw_eg2_nist_vseq
      sw_images: ["//sw/device/tests/eg2_nist:eg2_nist_sha2_cheriot:1:new_rules"]
      en_run_modes: ["sw_test_mode_test_rom"]
      build_mode: "en_eg2_cosim"
      run_opts: ["+sw_test_timeout_ns=2_000_000_000", "+eg2_nist=sha2", "+eg2_closes=chip_sw_eg2_nist_sha2:REQ_PBF_23,REQ_PBF_10", "+eg2_param_monte=1"]
      run_timeout_mins: 1440
    }
    {
      // The Monte Carlo vectors (1000 chained operations each): weekly.
      name: chip_sw_eg2_nist_sha3_monte
      uvm_test_seq: chip_sw_eg2_nist_vseq
      sw_images: ["//sw/device/tests/eg2_nist:eg2_nist_sha3:1:new_rules"]
      en_run_modes: ["sw_test_mode_test_rom"]
      build_mode: "en_eg2_cosim"
      run_opts: ["+sw_test_timeout_ns=2_000_000_000", "+eg2_nist=sha3", "+eg2_closes=chip_sw_eg2_nist_sha3:REQ_PBF_23,REQ_PBF_10", "+eg2_param_monte=1"]
      run_timeout_mins: 1440
    }
    {
      // The Monte Carlo vectors (1000 chained operations each): weekly.
      name: chip_sw_eg2_nist_sha3_cheriot_monte
      uvm_test_seq: chip_sw_eg2_nist_vseq
      sw_images: ["//sw/device/tests/eg2_nist:eg2_nist_sha3_cheriot:1:new_rules"]
      en_run_modes: ["sw_test_mode_test_rom"]
      build_mode: "en_eg2_cosim"
      run_opts: ["+sw_test_timeout_ns=2_000_000_000", "+eg2_nist=sha3", "+eg2_closes=chip_sw_eg2_nist_sha3:REQ_PBF_23,REQ_PBF_10", "+eg2_param_monte=1"]
      run_timeout_mins: 1440
    }
  ]

  regressions: [
    {
      // AES key wrap and the OTBN tests, nightly (RSA signing off).
      name: eg2_nist_otbn_kw
      tests: ["chip_sw_eg2_nist_aes_kw",
              "chip_sw_eg2_nist_aes_kw_cheriot",
              "chip_sw_eg2_nist_otbn_ecdsa",
              "chip_sw_eg2_nist_otbn_ecdh",
              "chip_sw_eg2_nist_otbn_rsa"]
    }
    {
      // Weekly: the Monte Carlo vectors and RSA signing.
      name: eg2_nist_weekly
      tests: ["chip_sw_eg2_nist_otbn_rsa_sign",
              "chip_sw_eg2_nist_sha2_monte",
              "chip_sw_eg2_nist_sha2_cheriot_monte",
              "chip_sw_eg2_nist_sha3_monte",
              "chip_sw_eg2_nist_sha3_cheriot_monte"]
    }
  ]
}
