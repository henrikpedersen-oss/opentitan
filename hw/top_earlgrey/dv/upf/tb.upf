#
# Power intent for power-aware simulation of the chip bench (dvsim build mode en_upf, make
# UPF_ENABLE=1): the chip's draft power intent, loaded at the chip instance tb.dut.

upf_version 2.1

set_design_top tb

# The bench itself: one always-on supply (a simulator needs a default power domain at the top).
create_supply_port VDD_TB
create_supply_port VSS_TB
create_supply_net VDD_TB
create_supply_net VSS_TB
connect_supply_net VDD_TB -ports VDD_TB
connect_supply_net VSS_TB -ports VSS_TB
create_supply_set SS_TB -function {power VDD_TB} -function {ground VSS_TB}
create_power_domain PD_TB -include_scope -supply {primary SS_TB}

load_upf [file join [file dirname [info script]] ../../syn/chip_earlgrey_asic.upf] -scope dut

# The chip's supply pins from the bench: all on for the whole run (the bench does not model the
# supplies themselves; VCMAIN follows pwrmgr through the chip's power switch).
connect_supply_net VDD_TB -ports {dut/VCC dut/VCAON dut/VIOA dut/VIOB dut/AVCC}
connect_supply_net VSS_TB -ports {dut/VSS}

# While the main domain is not on (deep sleep), its assertions are not evaluated: its logic,
# reset synchronisers included, is corrupted to X, so `disable iff (!rst_ni)` no longer holds them
# off and every assertion there would fire on the X (seen 2026-10-31: RspZero_A in sram_ctrl_meta's
# TL-UL adapter at the power-down of chip_sw_pwrmgr_smoketest). They start again from INACTIVE
# when the domain is back on. Cadence extension to IEEE 1801; it takes effect with Xcelium's
# -lps_enable_assertion_ctrl (chip_sim_cfg.hjson, build mode en_upf).
create_assertion_control -name AC_PD_MAIN_OFF -domains {dut/PD_MAIN} -type reset
