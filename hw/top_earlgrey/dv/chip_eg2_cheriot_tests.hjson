//
// EG2 CHERIoT suite (eg2_top_verification: status/test_writing_rules.md; spec "CHERIoT Test
// Suite", "Revocation", REQ_CMS, REQ_CIB, REQ_SOC). Software in sw/device/tests/eg2_cheriot/,
// sequences in env/seq_lib/ (chip_eg2_cheriot_vseq_list.sv). A test that runs in both modes is
// two runs (`_cheriot` the CHERIoT one); every `_inject_fail` run must FAIL (REQ_STE_03: Makefile
// MUST_FAIL_TESTS) and is in no regression list. chip_sw_eg2_rand_cap_ops, _rand_mem[_cheriot]
// and _rand_traps[_cheriot] keep their entries in chip_smoketests.hjson (eg2_cheriot_suite).
//
// Expected to fail on this RTL and boot flow (rtl_tickets.md): chip_cheriot_sba_tag_clear (F23:
// SBA writes bypass cheriot_mem_sys), chip_sw_cheriot_meta_init_after_reset (F11: no boot code
// initialises the meta SRAM), chip_sw_cheriot_periph_lock (F29: no boot stage locks the
// REQ_SOC_08 registers before the switch; +eg2_param_lock_first=1 checks the rest meanwhile).
{
  tests: [
    {
      name: chip_sw_cheriot_tag_roundtrip
      uvm_test_seq: chip_sw_eg2_tag_roundtrip_vseq
      sw_images: ["//sw/device/tests/eg2_cheriot:eg2_tag_roundtrip_cheriot:1:new_rules"]
      en_run_modes: ["sw_test_mode_test_rom"]
      build_mode: "en_eg2_cosim"
      run_opts: ["+sw_test_timeout_ns=200_000_000"]
      run_timeout_mins: 240
    }
    {
      name: chip_sw_cheriot_tag_roundtrip_inject_fail
      uvm_test_seq: chip_sw_eg2_tag_roundtrip_vseq
      sw_images: ["//sw/device/tests/eg2_cheriot:eg2_tag_roundtrip_cheriot_inject_fail:1:new_rules"]
      en_run_modes: ["sw_test_mode_test_rom"]
      build_mode: "en_eg2_cosim"
      run_opts: ["+sw_test_timeout_ns=200_000_000"]
      run_timeout_mins: 240
    }
    {
      name: chip_sw_cheriot_handover
      uvm_test_seq: chip_sw_eg2_handover_vseq
      sw_images: ["//sw/device/tests/eg2_cheriot:eg2_handover_cheriot:1:new_rules"]
      en_run_modes: ["sw_test_mode_test_rom"]
      build_mode: "en_eg2_cosim"
      run_opts: ["+sw_test_timeout_ns=50_000_000"]
      run_timeout_mins: 240
    }
    {
      // The Verilator-only hang of eg2_handover_cheriot (regr-vlt 2026-10-25: nothing on the
      // console after the test ROM's jump; the same image passes in eg2sim). The same image and
      // sequence on Xcelium, bounded so that a hang ends in minutes: run it with WAVES=1, and the
      // Ibex trace (trace_core_*.log) and the instruction check show where the core goes.
      name: chip_sw_cheriot_handover_hang
      uvm_test_seq: chip_sw_eg2_handover_vseq
      sw_images: ["//sw/device/tests/eg2_cheriot:eg2_handover_cheriot:1:new_rules"]
      en_run_modes: ["sw_test_mode_test_rom"]
      build_mode: "en_eg2_cosim"
      run_opts: ["+sw_test_timeout_ns=10_000_000"]
      reseed: 1
      run_timeout_mins: 60
    }
    {
      name: chip_sw_cheriot_handover_inject_fail
      uvm_test_seq: chip_sw_eg2_handover_vseq
      sw_images: ["//sw/device/tests/eg2_cheriot:eg2_handover_cheriot_inject_fail:1:new_rules"]
      en_run_modes: ["sw_test_mode_test_rom"]
      build_mode: "en_eg2_cosim"
