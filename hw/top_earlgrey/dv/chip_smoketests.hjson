{
  # This auxiliary chip sim cfg specification focuses on chip level smoke tests.
  # Please see chip_sim_cfg.hjson for full setup details.

  # Note: Please maintain alphabetical order.
  tests: [
    {
      name: chip_sw_aes_smoketest
      uvm_test_seq: chip_sw_base_vseq
      sw_images: ["//sw/device/tests:aes_smoketest:1:new_rules"]
      en_run_modes: ["sw_test_mode_test_rom"]
    }
    {
      name: chip_sw_aon_timer_smoketest
      uvm_test_seq: chip_sw_base_vseq
      sw_images: ["//sw/device/tests:aon_timer_smoketest:1:new_rules"]
      en_run_modes: ["sw_test_mode_test_rom"]
    }
    {
      // The CHERIoT variant locks the core into CHERIoT mode; the ePMP variant
      // locks it into ePMP. Between them they cover both locked states of the
      // execution mode switch FSM.
      name: chip_sw_cheriot_smoketest
      uvm_test_seq: chip_sw_base_vseq
      sw_images: ["//sw/device/tests:cheriot_smoketest:1:new_rules"]
      en_run_modes: ["sw_test_mode_test_rom"]
    }
    {
      name: chip_sw_cheriot_epmp_smoketest
      uvm_test_seq: chip_sw_base_vseq
      sw_images: ["//sw/device/tests:cheriot_smoketest_epmp:1:new_rules"]
      en_run_modes: ["sw_test_mode_test_rom"]
    }
    {
      // Every register window in both modes; in CHERIoT mode each device capability's bounds and
      // store permission as well (EG2 verification spec REQ_PER_01/02).
      name: chip_sw_cheriot_periph_smoketest
      uvm_test_seq: chip_sw_base_vseq
      sw_images: ["//sw/device/tests:cheriot_periph_smoketest:1:new_rules"]
      en_run_modes: ["sw_test_mode_test_rom"]
    }
    {
      name: chip_sw_cheriot_epmp_periph_smoketest
      uvm_test_seq: chip_sw_base_vseq
      sw_images: ["//sw/device/tests:cheriot_periph_smoketest_epmp:1:new_rules"]
      en_run_modes: ["sw_test_mode_test_rom"]
    }
    {
      // Must FAIL, with `FAIL b 00` on the UART: built to expect the wrong cause for the bounds
      // check, so a pass means the check is dead (EG2 verification spec REQ_STE_03). In no
      // regression list.
      name: chip_sw_cheriot_periph_smoketest_inject_fail
      uvm_test_seq: chip_sw_base_vseq
      sw_images: ["//sw/device/tests:cheriot_periph_smoketest_inject_fail:1:new_rules"]
      en_run_modes: ["sw_test_mode_test_rom"]
    }
    {
      // The EG2 framework's status module (alert handler, error interrupts, error registers,
      // mode, reset reason), one source in RISC-V mode (OTTF) and in CHERIoT mode.
      name: chip_sw_eg2_status_smoketest
      uvm_test_seq: chip_sw_eg2_status_smoketest_vseq
      sw_images: ["//sw/device/tests:eg2_status_smoketest:1:new_rules"]
      en_run_modes: ["sw_test_mode_test_rom"]
      build_mode: "en_eg2_cosim"
    }
    {
      name: chip_sw_eg2_status_smoketest_cheriot
      uvm_test_seq: chip_sw_eg2_status_smoketest_vseq
      sw_images: ["//sw/device/tests:eg2_status_smoketest_cheriot:1:new_rules"]
      en_run_modes: ["sw_test_mode_test_rom"]
      build_mode: "en_eg2_cosim"
    }
    {
      // Must FAIL, with `STATUS unexpected alert uart1_fatal_fault` (REQ_STE_03). In no
      // regression list.
      name: chip_sw_eg2_status_smoketest_inject_fail
      uvm_test_seq: chip_sw_eg2_status_smoketest_vseq
      sw_images: ["//sw/device/tests:eg2_status_smoketest_inject_fail:1:new_rules"]
      en_run_modes: ["sw_test_mode_test_rom"]
      build_mode: "en_eg2_cosim"
    }
    {
      name: chip_sw_eg2_status_smoketest_cheriot_inject_fail
      uvm_test_seq: chip_sw_eg2_status_smoketest_vseq
      sw_images: ["//sw/device/tests:eg2_status_smoketest_cheriot_inject_fail:1:new_rules"]
      en_run_modes: ["sw_test_mode_test_rom"]
      build_mode: "en_eg2_cosim"
    }
    {
      // OpenTitan's DIFs and abs_mmio, unchanged, in both modes (EG2 framework step 3).
      name: chip_sw_eg2_dif_smoketest
      uvm_test_seq: chip_sw_eg2_base_vseq
      sw_images: ["//sw/device/tests:eg2_dif_smoketest:1:new_rules"]
      en_run_modes: ["sw_test_mode_test_rom"]
      build_mode: "en_eg2_cosim"
    }
    {
      name: chip_sw_eg2_dif_smoketest_cheriot
      uvm_test_seq: chip_sw_eg2_base_vseq
      sw_images: ["//sw/device/tests:eg2_dif_smoketest_cheriot:1:new_rules"]
      en_run_modes: ["sw_test_mode_test_rom"]
      build_mode: "en_eg2_cosim"
    }
    {
      // Must FAIL, with `step FAILED: UART1 loopback` (REQ_STE_03). In no regression list.
      name: chip_sw_eg2_dif_smoketest_inject_fail
      uvm_test_seq: chip_sw_eg2_base_vseq
      sw_images: ["//sw/device/tests:eg2_dif_smoketest_inject_fail:1:new_rules"]
      en_run_modes: ["sw_test_mode_test_rom"]
      build_mode: "en_eg2_cosim"
    }
    {
      name: chip_sw_eg2_dif_smoketest_cheriot_inject_fail
      uvm_test_seq: chip_sw_eg2_base_vseq
      sw_images: ["//sw/device/tests:eg2_dif_smoketest_cheriot_inject_fail:1:new_rules"]
      en_run_modes: ["sw_test_mode_test_rom"]
      build_mode: "en_eg2_cosim"
    }
    {
      // The status smoke test behind the full secure-boot chain: the ROM (mask ROM, fake keys)
      // verifies ROM_EXT, ROM_EXT verifies the test as a signed owner image (exec env
      // sim_dv_rom_ext, image flag `rom_ext`). EG2 framework step 6, REQ_PBF_01.
      name: chip_sw_eg2_status_smoketest_secure_boot
      uvm_test_seq: chip_sw_eg2_status_smoketest_vseq
      sw_images: ["//sw/device/tests:eg2_status_smoketest:1:rom_ext"]
      en_run_modes: ["sw_test_mode_rom_ext"]
      build_mode: "en_eg2_cosim"
      // The ROM alone needs 9 ms before ROM_EXT starts; 300 ms, as the boot tests.
      // The wall clock ends such a run long before 300 ms: the core staying in one loop for 8 ms
      // fails the run instead (chip_sw_eg2_base_vseq watch_core_progress; the ROM's OTBN signature
      // wait, the longest meant to be, is about 6 ms).
      run_opts: ["+sw_test_timeout_ns=300_000_000", "+eg2_stall_limit_ns=8_000_000"]
      run_timeout_mins: 480
    }
    {
      // The same, the owner image switching to CHERIoT mode after ROM_EXT.
      name: chip_sw_eg2_status_smoketest_cheriot_secure_boot
      uvm_test_seq: chip_sw_eg2_status_smoketest_vseq
      sw_images: ["//sw/device/tests:eg2_status_smoketest_cheriot:1:rom_ext"]
      en_run_modes: ["sw_test_mode_rom_ext"]
      build_mode: "en_eg2_cosim"
      // The ROM alone needs 9 ms before ROM_EXT starts; 300 ms, as the boot tests.
      // The wall clock ends such a run long before 300 ms: the core staying in one loop for 8 ms
      // fails the run instead (chip_sw_eg2_base_vseq watch_core_progress; the ROM's OTBN signature
      // wait, the longest meant to be, is about 6 ms).
      run_opts: ["+sw_test_timeout_ns=300_000_000", "+eg2_stall_limit_ns=8_000_000"]
      run_timeout_mins: 480
    }
    {
      // Must FAIL with `EG2_SB rvfi: RVFI is built but no instruction retired`: the scoreboard's
      // count check shown to fail (REQ_STE_03). In no regression list.
      name: chip_sw_eg2_status_smoketest_sb_corrupt_rvfi
      uvm_test_seq: chip_sw_eg2_status_smoketest_vseq
      sw_images: ["//sw/device/tests:eg2_status_smoketest:1:new_rules"]
      en_run_modes: ["sw_test_mode_test_rom"]
      build_mode: "en_eg2_cosim"
      run_opts: ["+sb_corrupt=rvfi.count"]
    }
    {
      // Must FAIL with `EG2_SB insn mismatch`: one register result corrupted before Spike checks
      // it, the instruction comparator shown to fail (REQ_STE_03). In no regression list.
      name: chip_sw_eg2_status_smoketest_sb_corrupt_insn
      uvm_test_seq: chip_sw_eg2_status_smoketest_vseq
      sw_images: ["//sw/device/tests:eg2_status_smoketest:1:new_rules"]
      en_run_modes: ["sw_test_mode_test_rom"]
      build_mode: "en_eg2_cosim"
      run_opts: ["+sb_corrupt=insn.rd"]
    }
    {
      // Must FAIL with `EG2_SB insn mismatch`: one CHERIoT-mode register result corrupted before
      // CHERIoT-Sail checks it (REQ_STE_03). In no regression list.
      name: chip_sw_eg2_status_smoketest_cheriot_sb_corrupt_insn
      uvm_test_seq: chip_sw_eg2_status_smoketest_vseq
      sw_images: ["//sw/device/tests:eg2_status_smoketest_cheriot:1:new_rules"]
      en_run_modes: ["sw_test_mode_test_rom"]
      build_mode: "en_eg2_cosim"
      run_opts: ["+sb_corrupt=insn.cheriot_rd"]
    }
    {
      // Must FAIL with `EG2_SB uart0: the test uses it but its monitor saw nothing`.
      name: chip_sw_eg2_status_smoketest_sb_corrupt_uart0
      uvm_test_seq: chip_sw_eg2_status_smoketest_vseq
      sw_images: ["//sw/device/tests:eg2_status_smoketest:1:new_rules"]
      en_run_modes: ["sw_test_mode_test_rom"]
      build_mode: "en_eg2_cosim"
      run_opts: ["+sb_corrupt=uart0.count"]
    }
    {
      // The framework tests with the EG2 SystemC model in the bench (build mode en_eg2_model,
      // eg2_sysmodel.sv): loads predicted by the model, the UARTs' items compared with its items.
      // libeg2sysmodel.so first: eg2_top_verification's `make eg2sysmodel`.
      name: chip_sw_eg2_status_smoketest_model
      uvm_test_seq: chip_sw_eg2_status_smoketest_vseq
      sw_images: ["//sw/device/tests:eg2_status_smoketest:1:new_rules"]
      en_run_modes: ["sw_test_mode_test_rom"]
      build_mode: "en_eg2_model"
    }
    {
      name: chip_sw_eg2_dif_smoketest_model
      uvm_test_seq: chip_sw_eg2_base_vseq
      sw_images: ["//sw/device/tests:eg2_dif_smoketest:1:new_rules"]
      en_run_modes: ["sw_test_mode_test_rom"]
      build_mode: "en_eg2_model"
    }
    {
      // Must FAIL with `EG2_SB insn mismatch ... model: load`: the 100th predicted load's chip
      // value inverted before the model's prediction is compared (REQ_STE_03). In no regression
      // list.
      name: chip_sw_eg2_status_smoketest_model_corrupt_load
      uvm_test_seq: chip_sw_eg2_status_smoketest_vseq
      sw_images: ["//sw/device/tests:eg2_status_smoketest:1:new_rules"]
      en_run_modes: ["sw_test_mode_test_rom"]
      build_mode: "en_eg2_model"
      run_opts: ["+eg2_model_corrupt=load"]
    }
    {
      // Must FAIL with `EG2_SB uart0 item 10`: one chip UART item corrupted before it is compared
      // with the model's (REQ_STE_03). In no regression list.
      name: chip_sw_eg2_status_smoketest_model_corrupt_uart0
      uvm_test_seq: chip_sw_eg2_status_smoketest_vseq
      sw_images: ["//sw/device/tests:eg2_status_smoketest:1:new_rules"]
      en_run_modes: ["sw_test_mode_test_rom"]
      build_mode: "en_eg2_model"
      run_opts: ["+eg2_model_corrupt=uart0"]
    }
    {
      // The CHERIoT test suite (EG2 verification spec "CHERIoT Test Suite"; images in
      // //sw/device/tests/eg2_cheriot). Each run is 0.5 to 16 million instructions of software,
      // its seed and knobs drawn from the run's seed (kEg2Seed). CHERIoT mode only.
      name: chip_sw_eg2_rand_cap_ops
      uvm_test_seq: chip_sw_eg2_base_vseq
      sw_images: ["//sw/device/tests/eg2_cheriot:eg2_rand_cap_ops_cheriot:1:new_rules"]
      en_run_modes: ["sw_test_mode_test_rom"]
      build_mode: "en_eg2_cosim"
      run_opts: ["+sw_test_timeout_ns=1_000_000_000"]
      run_timeout_mins: 720
    }
    {
      // Capability bounds edges for every access kind (CHERIoT); ePMP region edges (RISC-V).
      name: chip_sw_eg2_rand_mem
      uvm_test_seq: chip_sw_eg2_base_vseq
      sw_images: ["//sw/device/tests/eg2_cheriot:eg2_rand_mem:1:new_rules"]
      en_run_modes: ["sw_test_mode_test_rom"]
      build_mode: "en_eg2_cosim"
      run_opts: ["+sw_test_timeout_ns=1_000_000_000"]
      run_timeout_mins: 720
    }
    {
      name: chip_sw_eg2_rand_mem_cheriot
      uvm_test_seq: chip_sw_eg2_base_vseq
      sw_images: ["//sw/device/tests/eg2_cheriot:eg2_rand_mem_cheriot:1:new_rules"]
      en_run_modes: ["sw_test_mode_test_rom"]
      build_mode: "en_eg2_cosim"
      run_opts: ["+sw_test_timeout_ns=1_000_000_000"]
      run_timeout_mins: 720
    }
    {
      // PCC bounds edges, sentries, SR, illegal encodings, interrupts (CHERIoT); ePMP execute
      // edges, U mode, illegal encodings, interrupts (RISC-V).
      name: chip_sw_eg2_rand_traps
      uvm_test_seq: chip_sw_eg2_base_vseq
      sw_images: ["//sw/device/tests/eg2_cheriot:eg2_rand_traps:1:new_rules"]
      en_run_modes: ["sw_test_mode_test_rom"]
      build_mode: "en_eg2_cosim"
      run_opts: ["+sw_test_timeout_ns=1_000_000_000"]
      run_timeout_mins: 720
    }
    {
      name: chip_sw_eg2_rand_traps_cheriot
      uvm_test_seq: chip_sw_eg2_base_vseq
      sw_images: ["//sw/device/tests/eg2_cheriot:eg2_rand_traps_cheriot:1:new_rules"]
      en_run_modes: ["sw_test_mode_test_rom"]
      build_mode: "en_eg2_cosim"
      run_opts: ["+sw_test_timeout_ns=1_000_000_000"]
      run_timeout_mins: 720
    }
    {
      // Must FAIL: each breaks one expected value (REQ_STE_03): cap_ops expects CSetBoundsExact
      // of 1001 bytes to keep its tag, rand_mem a trapping access not to trap, rand_traps a fetch
      // past PCC's top to arrive. In no regression list.
      name: chip_sw_eg2_rand_cap_ops_inject_fail
      uvm_test_seq: chip_sw_eg2_base_vseq
      sw_images: ["//sw/device/tests/eg2_cheriot:eg2_rand_cap_ops_cheriot_inject_fail:1:new_rules"]
      en_run_modes: ["sw_test_mode_test_rom"]
      build_mode: "en_eg2_cosim"
      run_opts: ["+sw_test_timeout_ns=1_000_000_000"]
      run_timeout_mins: 720
    }
    {
      name: chip_sw_eg2_rand_mem_inject_fail
      uvm_test_seq: chip_sw_eg2_base_vseq
      sw_images: ["//sw/device/tests/eg2_cheriot:eg2_rand_mem_inject_fail:1:new_rules"]
      en_run_modes: ["sw_test_mode_test_rom"]
      build_mode: "en_eg2_cosim"
      run_opts: ["+sw_test_timeout_ns=1_000_000_000"]
      run_timeout_mins: 720
    }
    {
      name: chip_sw_eg2_rand_mem_cheriot_inject_fail
      uvm_test_seq: chip_sw_eg2_base_vseq
      sw_images: ["//sw/device/tests/eg2_cheriot:eg2_rand_mem_cheriot_inject_fail:1:new_rules"]
      en_run_modes: ["sw_test_mode_test_rom"]
      build_mode: "en_eg2_cosim"
      run_opts: ["+sw_test_timeout_ns=1_000_000_000"]
      run_timeout_mins: 720
    }
    {
      name: chip_sw_eg2_rand_traps_inject_fail
      uvm_test_seq: chip_sw_eg2_base_vseq
      sw_images: ["//sw/device/tests/eg2_cheriot:eg2_rand_traps_inject_fail:1:new_rules"]
      en_run_modes: ["sw_test_mode_test_rom"]
      build_mode: "en_eg2_cosim"
      run_opts: ["+sw_test_timeout_ns=1_000_000_000"]
      run_timeout_mins: 720
    }
    {
      name: chip_sw_eg2_rand_traps_cheriot_inject_fail
      uvm_test_seq: chip_sw_eg2_base_vseq
      sw_images: ["//sw/device/tests/eg2_cheriot:eg2_rand_traps_cheriot_inject_fail:1:new_rules"]
      en_run_modes: ["sw_test_mode_test_rom"]
      build_mode: "en_eg2_cosim"
      run_opts: ["+sw_test_timeout_ns=1_000_000_000"]
      run_timeout_mins: 720
    }
    {
      // Every register of every register window (EG2 verification spec "Registers and
      // memories"; images in //sw/device/tests/eg2_regmem), in both modes. The tables are
      // generated from the IPs' hjson (eg2_top_verification scripts/gen_eg2_regmem_tables.py).
      name: chip_sw_eg2_rand_regs
      uvm_test_seq: chip_sw_eg2_rand_regs_vseq
      sw_images: ["//sw/device/tests/eg2_regmem:eg2_rand_regs:1:new_rules"]
      en_run_modes: ["sw_test_mode_test_rom"]
      build_mode: "en_eg2_cosim"
      run_opts: ["+sw_test_timeout_ns=200_000_000"]
      run_timeout_mins: 480
    }
    {
      name: chip_sw_eg2_rand_regs_cheriot
      uvm_test_seq: chip_sw_eg2_rand_regs_vseq
      sw_images: ["//sw/device/tests/eg2_regmem:eg2_rand_regs_cheriot:1:new_rules"]
      en_run_modes: ["sw_test_mode_test_rom"]
      build_mode: "en_eg2_cosim"
      run_opts: ["+sw_test_timeout_ns=200_000_000"]
      run_timeout_mins: 480
    }
    {
      // Memory-test algorithms over every memory the core reaches, in both modes.
      name: chip_sw_eg2_mem_test
      uvm_test_seq: chip_sw_eg2_mem_test_vseq
      sw_images: ["//sw/device/tests/eg2_regmem:eg2_mem_test:1:new_rules"]
      en_run_modes: ["sw_test_mode_test_rom"]
      build_mode: "en_eg2_cosim"
      run_opts: ["+sw_test_timeout_ns=1_000_000_000"]
      run_timeout_mins: 720
    }
    {
      name: chip_sw_eg2_mem_test_cheriot
      uvm_test_seq: chip_sw_eg2_mem_test_vseq
      sw_images: ["//sw/device/tests/eg2_regmem:eg2_mem_test_cheriot:1:new_rules"]
      en_run_modes: ["sw_test_mode_test_rom"]
      build_mode: "en_eg2_cosim"
      run_opts: ["+sw_test_timeout_ns=1_000_000_000"]
      run_timeout_mins: 720
    }
    {
      // Every block present and connected (registers, interrupts at rv_plic, alerts at the alert
      // handler, the connections between blocks without pins), in both modes.
      name: chip_sw_eg2_connectivity
      uvm_test_seq: chip_sw_eg2_connectivity_vseq
      sw_images: ["//sw/device/tests/eg2_regmem:eg2_connectivity:1:new_rules"]
      en_run_modes: ["sw_test_mode_test_rom"]
      build_mode: "en_eg2_cosim"
      run_opts: ["+sw_test_timeout_ns=200_000_000"]
      run_timeout_mins: 480
    }
    {
      name: chip_sw_eg2_connectivity_cheriot
      uvm_test_seq: chip_sw_eg2_connectivity_vseq
      sw_images: ["//sw/device/tests/eg2_regmem:eg2_connectivity_cheriot:1:new_rules"]
      en_run_modes: ["sw_test_mode_test_rom"]
      build_mode: "en_eg2_cosim"
      run_opts: ["+sw_test_timeout_ns=200_000_000"]
      run_timeout_mins: 480
    }
    {
      // Must FAIL (REQ_STE_03): rand_regs with `REG FAIL` and mem_test with `MEM FAIL` (the first
      // compared value expected with one bit flipped), connectivity with
      // `CONN <block> FAIL interrupt` (the first interrupt expected at the wrong source ID). In no
      // regression list.
      name: chip_sw_eg2_rand_regs_inject_fail
      uvm_test_seq: chip_sw_eg2_rand_regs_vseq
      sw_images: ["//sw/device/tests/eg2_regmem:eg2_rand_regs_inject_fail:1:new_rules"]
      en_run_modes: ["sw_test_mode_test_rom"]
      build_mode: "en_eg2_cosim"
      run_opts: ["+sw_test_timeout_ns=200_000_000"]
      run_timeout_mins: 480
    }
    {
      name: chip_sw_eg2_rand_regs_cheriot_inject_fail
      uvm_test_seq: chip_sw_eg2_rand_regs_vseq
      sw_images: ["//sw/device/tests/eg2_regmem:eg2_rand_regs_cheriot_inject_fail:1:new_rules"]
      en_run_modes: ["sw_test_mode_test_rom"]
      build_mode: "en_eg2_cosim"
      run_opts: ["+sw_test_timeout_ns=200_000_000"]
      run_timeout_mins: 480
    }
    {
      name: chip_sw_eg2_mem_test_inject_fail
      uvm_test_seq: chip_sw_eg2_mem_test_vseq
      sw_images: ["//sw/device/tests/eg2_regmem:eg2_mem_test_inject_fail:1:new_rules"]
      en_run_modes: ["sw_test_mode_test_rom"]
      build_mode: "en_eg2_cosim"
      run_opts: ["+sw_test_timeout_ns=1_000_000_000"]
      run_timeout_mins: 720
    }
    {
      name: chip_sw_eg2_mem_test_cheriot_inject_fail
      uvm_test_seq: chip_sw_eg2_mem_test_vseq
      sw_images: ["//sw/device/tests/eg2_regmem:eg2_mem_test_cheriot_inject_fail:1:new_rules"]
      en_run_modes: ["sw_test_mode_test_rom"]
      build_mode: "en_eg2_cosim"
      run_opts: ["+sw_test_timeout_ns=1_000_000_000"]
      run_timeout_mins: 720
    }
    {
      name: chip_sw_eg2_connectivity_inject_fail
      uvm_test_seq: chip_sw_eg2_connectivity_vseq
      sw_images: ["//sw/device/tests/eg2_regmem:eg2_connectivity_inject_fail:1:new_rules"]
      en_run_modes: ["sw_test_mode_test_rom"]
      build_mode: "en_eg2_cosim"
      run_opts: ["+sw_test_timeout_ns=200_000_000"]
      run_timeout_mins: 480
    }
    {
      name: chip_sw_eg2_connectivity_cheriot_inject_fail
      uvm_test_seq: chip_sw_eg2_connectivity_vseq
      sw_images: ["//sw/device/tests/eg2_regmem:eg2_connectivity_cheriot_inject_fail:1:new_rules"]
      en_run_modes: ["sw_test_mode_test_rom"]
      build_mode: "en_eg2_cosim"
      run_opts: ["+sw_test_timeout_ns=200_000_000"]
      run_timeout_mins: 480
    }
