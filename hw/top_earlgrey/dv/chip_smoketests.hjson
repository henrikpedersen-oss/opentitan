  regressions: [
    {
      // The NIST CAVP tests (the `_inject_fail` builds are run on their own, and must fail).
      name: eg2_nist
      tests: ["chip_sw_eg2_nist_aes", "chip_sw_eg2_nist_aes_cheriot",
              "chip_sw_eg2_nist_aes_gcm", "chip_sw_eg2_nist_aes_gcm_cheriot",
              "chip_sw_eg2_nist_sha2", "chip_sw_eg2_nist_sha2_cheriot",
              "chip_sw_eg2_nist_hmac", "chip_sw_eg2_nist_hmac_cheriot",
              "chip_sw_eg2_nist_sha3", "chip_sw_eg2_nist_sha3_cheriot",
              "chip_sw_eg2_nist_drbg", "chip_sw_eg2_nist_drbg_cheriot",
            ]
    }
    {
      name: smoke
      tests: ["chip_sw_pwrmgr_smoketest"]
    }
    {
      // The CHERIoT test suite's runs (the `_inject_fail` builds are run on their own).
      name: eg2_cheriot_suite
      tests: ["chip_sw_eg2_rand_cap_ops",
              "chip_sw_eg2_rand_mem",
              "chip_sw_eg2_rand_mem_cheriot",
              "chip_sw_eg2_rand_traps",
              "chip_sw_eg2_rand_traps_cheriot",
            ]
    }
    {
      // The register, memory and connectivity tests (the `_inject_fail` builds are run on their
      // own). Each passes in eg2sim in both modes before it runs here (EG2 spec REQ_STE_11).
      name: eg2_regmem
      tests: ["chip_sw_eg2_connectivity_slice0",
              "chip_sw_eg2_connectivity_slice1",
              "chip_sw_eg2_connectivity_slice2",
              "chip_sw_eg2_connectivity_slice3",
              "chip_sw_eg2_connectivity_cheriot_slice0a",
              "chip_sw_eg2_connectivity_cheriot_slice0b",
              "chip_sw_eg2_connectivity_cheriot_slice1a",
              "chip_sw_eg2_connectivity_cheriot_slice1b",
              "chip_sw_eg2_connectivity_cheriot_slice2a",
              "chip_sw_eg2_connectivity_cheriot_slice2b",
              "chip_sw_eg2_connectivity_cheriot_slice3a",
              "chip_sw_eg2_connectivity_cheriot_slice3b",
              "chip_sw_eg2_mem_test",
              "chip_sw_eg2_mem_test_cheriot",
            ]
    }
    {
      // The register tests on their own, in 8 fixed slices of windows per mode that together check
      // every window (2026-11-03; before, 4-12 random windows per run and six seeds, which hit
      // the run-time limit).
      name: eg2_regmem_regs
      tests: ["chip_sw_eg2_rand_regs_slice0",
              "chip_sw_eg2_rand_regs_slice1a",
              "chip_sw_eg2_rand_regs_slice1b",
              "chip_sw_eg2_rand_regs_slice1c",
              "chip_sw_eg2_rand_regs_slice1d",
              "chip_sw_eg2_rand_regs_slice1e",
              "chip_sw_eg2_rand_regs_slice2",
              "chip_sw_eg2_rand_regs_slice3",
              "chip_sw_eg2_rand_regs_slice4",
              "chip_sw_eg2_rand_regs_slice5",
              "chip_sw_eg2_rand_regs_slice6",
              "chip_sw_eg2_rand_regs_slice7",
              "chip_sw_eg2_rand_regs_cheriot_slice0",
              "chip_sw_eg2_rand_regs_cheriot_slice1a",
              "chip_sw_eg2_rand_regs_cheriot_slice1b",
              "chip_sw_eg2_rand_regs_cheriot_slice1c",
              "chip_sw_eg2_rand_regs_cheriot_slice1d",
              "chip_sw_eg2_rand_regs_cheriot_slice1e",
              "chip_sw_eg2_rand_regs_cheriot_slice2",
              "chip_sw_eg2_rand_regs_cheriot_slice3",
              "chip_sw_eg2_rand_regs_cheriot_slice4",
              "chip_sw_eg2_rand_regs_cheriot_slice5",
              "chip_sw_eg2_rand_regs_cheriot_slice6",
              "chip_sw_eg2_rand_regs_cheriot_slice7",
            ]
    }
