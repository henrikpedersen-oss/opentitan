    {
      // Half of CHERIoT slice 2: CHERIoT-mode runs take about twice the wall time of plain ones
      // and the whole slice outran the 240-minute limit (3 Nov).
      // Slice 2b of 4 (pinmux, aon_timer, rv_dm.regs, entropy_src, edn0, rom_ctrl.regs).
      name: chip_sw_eg2_connectivity_cheriot_slice2b
