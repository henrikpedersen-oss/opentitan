    {
      // Half of CHERIoT slice 1: CHERIoT-mode runs take about twice the wall time of plain ones
      // and the whole slice outran the 240-minute limit (3 Nov).
      // Slice 1a of 4 (uart0, uart2, lc_ctrl.regs, alert_handler, usbdev, clkmgr).
      name: chip_sw_eg2_connectivity_cheriot_slice1a
      uvm_test_seq: chip_sw_eg2_connectivity_vseq
