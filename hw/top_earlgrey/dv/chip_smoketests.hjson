      en_run_modes: ["sw_test_mode_test_rom"]
      build_mode: "en_eg2_cosim"
      run_opts: ["+sw_test_timeout_ns=500_000_000"]
      run_timeout_mins: 480
    }
    // The connectivity and register tests split into fixed slices of blocks (2026-11-03): a whole
    // run took 4.5 to 8 hours and was stopped by the run-time limit. Together the slices cover
    // every block once per mode; the block sets are balanced by interrupts and alerts
    // (connectivity) and by registers (rand_regs). The links between blocks run in slice 0.
    {
      // Slice 0 of 4 (uart3, gpio, i3c0, rv_timer, spi_host1, rstmgr, ast, rv_dm.mem, aes, hmac, kmac, sram_ctrl_main.regs).
      name: chip_sw_eg2_connectivity_slice0
      uvm_test_seq: chip_sw_eg2_connectivity_vseq
      sw_images: ["//sw/device/tests/eg2_regmem:eg2_connectivity:1:new_rules"]
      en_run_modes: ["sw_test_mode_test_rom"]
      build_mode: "en_eg2_cosim"
      run_opts: ["+sw_test_timeout_ns=200_000_000", "+eg2_param_blocks_lo=1107888664", "+eg2_param_blocks_hi=1038", "+eg2_param_links=1"]
      run_timeout_mins: 480
    }
    {
      // Slice 1 of 4 (uart0, uart2, lc_ctrl.regs, alert_handler, usbdev, clkmgr, rram_macro.prim, otbn, csrng, edn1, sram_ctrl_sec.regs, cheriot_mem_sys.regs).
      name: chip_sw_eg2_connectivity_slice1
      uvm_test_seq: chip_sw_eg2_connectivity_vseq
      sw_images: ["//sw/device/tests/eg2_regmem:eg2_connectivity:1:new_rules"]
      en_run_modes: ["sw_test_mode_test_rom"]
      build_mode: "en_eg2_cosim"
      run_opts: ["+sw_test_timeout_ns=200_000_000", "+eg2_param_blocks_lo=538075141", "+eg2_param_blocks_hi=19024", "+eg2_param_links=0"]
      run_timeout_mins: 480
    }
    {
      // Slice 2 of 4 (spi_device, i2c0, i2c2, i3c1, pwrmgr, sysrst_ctrl, pinmux, aon_timer, rv_dm.regs, entropy_src, edn0, rom_ctrl.regs).
      name: chip_sw_eg2_connectivity_slice2
      uvm_test_seq: chip_sw_eg2_connectivity_vseq
      sw_images: ["//sw/device/tests/eg2_regmem:eg2_connectivity:1:new_rules"]
      en_run_modes: ["sw_test_mode_test_rom"]
      build_mode: "en_eg2_cosim"
      run_opts: ["+sw_test_timeout_ns=200_000_000", "+eg2_param_blocks_lo=2175010144", "+eg2_param_blocks_hi=4480", "+eg2_param_links=0"]
      run_timeout_mins: 480
    }
    {
      // Slice 3 of 4 (uart1, i2c1, otp_ctrl.core, spi_host0, adc_ctrl, sensor_ctrl, sram_ctrl_ret.regs, rram_ctrl.core, rv_plic, keymgr_dpe, rv_core_ibex.cfg, sram_ctrl_meta.regs).
      name: chip_sw_eg2_connectivity_slice3
      uvm_test_seq: chip_sw_eg2_connectivity_vseq
      sw_images: ["//sw/device/tests/eg2_regmem:eg2_connectivity:1:new_rules"]
      en_run_modes: ["sw_test_mode_test_rom"]
      build_mode: "en_eg2_cosim"
      run_opts: ["+sw_test_timeout_ns=200_000_000", "+eg2_param_blocks_lo=473993346", "+eg2_param_blocks_hi=40993", "+eg2_param_links=0"]
      run_timeout_mins: 480
    }
    {
      // Half of CHERIoT slice 0: CHERIoT-mode runs take about twice the wall time of plain ones
      // and the whole slice outran the 240-minute limit (3 Nov).
      // Slice 0a of 4 (uart3, gpio, i3c0, rv_timer, spi_host1, rstmgr).
      name: chip_sw_eg2_connectivity_cheriot_slice0a
      uvm_test_seq: chip_sw_eg2_connectivity_vseq
