      name: chip_sw_eg2_connectivity_cheriot_slice1b
      uvm_test_seq: chip_sw_eg2_connectivity_vseq
      sw_images: ["//sw/device/tests/eg2_regmem:eg2_connectivity_cheriot:1:new_rules"]
