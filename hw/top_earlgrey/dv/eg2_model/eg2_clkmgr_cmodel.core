name: "lowrisc:dv:eg2_clkmgr_cmodel:0.1"
description: "clkmgr clock manager reference model (C++) and its DPI package"

filesets:
  files_dv:
    files:
      - ip/eg2_clkmgr_core.h: { file_type: cppSource, is_include_file: true }
      - dpi/eg2_clkmgr_dpi.cc: { file_type: cppSource }
      - dpi/eg2_clkmgr_cmodel_pkg.sv: { file_type: systemVerilogSource }

targets:
  default:
    filesets:
      - files_dv
