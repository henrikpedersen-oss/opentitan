{
  // The EG2 peripheral area (eg2_top_verification spec REQ_PBF_13, "Chip-Level Scoreboard"):
  // the tests of //sw/device/tests/eg2_periph, the framework smoke tests and the legacy peripheral
  // tests, all in build mode en_eg2_periph (one scoreboard per peripheral, the path check, the
  // injection registry; chip_sim_cfg.hjson). Imported by chip_sim_cfg.hjson; its vseqs are in
  // env/seq_lib/chip_eg2_periph_vseq_list.sv.
  tests: [
    {
      // The EG2 peripheral tests (EG2 spec REQ_PBF_13; software in //sw/device/tests/eg2_periph, vseqs
      // chip_sw_eg2_pbf_periph_vseq.sv) in build mode en_eg2_periph: every peripheral has its own
      // scoreboard (expected items from its TL-UL port, actual from its agent; <instance>.chip.log).
      // Each passed in eg2sim, both modes, and its _inject_fail failed there (REQ_STE_11).
      // chip_sw_eg2_pbf_periph_sb: UART1-3, SPI host, I2C0-2 and GPIO traffic behind secure boot
      // (ROM, ROM_EXT, the test as a signed owner image: the knobs keep the image's defaults).
      name: chip_sw_eg2_pbf_periph_sb
      uvm_test_seq: chip_sw_eg2_pbf_periph_sb_vseq
      sw_images: ["//sw/device/tests/eg2_periph:eg2_pbf_periph_sb:1:rom_ext"]
      en_run_modes: ["sw_test_mode_mask_rom"]
      build_mode: "en_eg2_periph"
      run_opts: ["+sw_test_timeout_ns=150_000_000", "+eg2_closes=chip_sw_eg2_pbf_periph_sb:REQ_PBF_13,REQ_PER_10,REQ_PER_11,REQ_PER_13,REQ_PER_15"]
      run_timeout_mins: 480
    }
    {
      name: chip_sw_eg2_pbf_periph_sb_cheriot
      uvm_test_seq: chip_sw_eg2_pbf_periph_sb_vseq
      sw_images: ["//sw/device/tests/eg2_periph:eg2_pbf_periph_sb_cheriot:1:rom_ext"]
      en_run_modes: ["sw_test_mode_mask_rom"]
      build_mode: "en_eg2_periph"
      run_opts: ["+sw_test_timeout_ns=150_000_000", "+eg2_closes=chip_sw_eg2_pbf_periph_sb:REQ_PBF_13,REQ_PER_10,REQ_PER_11,REQ_PER_13,REQ_PER_15"]
      run_timeout_mins: 480
    }
    {
      // The same test in direct boot (the test ROM), where the bench draws the knobs and the
      // instruction check runs.
      name: chip_sw_eg2_pbf_periph_sb_direct
      uvm_test_seq: chip_sw_eg2_pbf_periph_sb_vseq
      sw_images: ["//sw/device/tests/eg2_periph:eg2_pbf_periph_sb:1:new_rules"]
      en_run_modes: ["sw_test_mode_test_rom"]
      build_mode: "en_eg2_periph"
      run_opts: ["+sw_test_timeout_ns=150_000_000", "+eg2_closes=chip_sw_eg2_pbf_periph_sb:REQ_PBF_13,REQ_PER_10,REQ_PER_11,REQ_PER_13,REQ_PER_15"]
      run_timeout_mins: 480
    }
    {
      name: chip_sw_eg2_pbf_periph_sb_cheriot_direct
      uvm_test_seq: chip_sw_eg2_pbf_periph_sb_vseq
      sw_images: ["//sw/device/tests/eg2_periph:eg2_pbf_periph_sb_cheriot:1:new_rules"]
      en_run_modes: ["sw_test_mode_test_rom"]
      build_mode: "en_eg2_periph"
      run_opts: ["+sw_test_timeout_ns=150_000_000", "+eg2_closes=chip_sw_eg2_pbf_periph_sb:REQ_PBF_13,REQ_PER_10,REQ_PER_11,REQ_PER_13,REQ_PER_15"]
      run_timeout_mins: 480
    }
    {
      // A transfer on UART1, spi_host0 or I2C0 reset in its middle (the IP's own reset or rstmgr's).
      name: chip_sw_eg2_pbf_periph_fault
      uvm_test_seq: chip_sw_eg2_pbf_periph_fault_vseq
      sw_images: ["//sw/device/tests/eg2_periph:eg2_pbf_periph_fault:1:new_rules"]
      en_run_modes: ["sw_test_mode_test_rom"]
      build_mode: "en_eg2_periph"
      run_opts: ["+sw_test_timeout_ns=150_000_000", "+eg2_closes=chip_sw_eg2_pbf_periph_fault:REQ_PBF_13"]
      run_timeout_mins: 480
    }
    {
      name: chip_sw_eg2_pbf_periph_fault_cheriot
      uvm_test_seq: chip_sw_eg2_pbf_periph_fault_vseq
      sw_images: ["//sw/device/tests/eg2_periph:eg2_pbf_periph_fault_cheriot:1:new_rules"]
      en_run_modes: ["sw_test_mode_test_rom"]
      build_mode: "en_eg2_periph"
      run_opts: ["+sw_test_timeout_ns=150_000_000", "+eg2_closes=chip_sw_eg2_pbf_periph_fault:REQ_PBF_13"]
      run_timeout_mins: 480
    }
    {
      // Must FAIL with `PERIPH FAIL` (REQ_STE_03): the first data check expects bit 0 flipped. In no
      // regression list.
      name: chip_sw_eg2_pbf_periph_sb_inject_fail
      uvm_test_seq: chip_sw_eg2_pbf_periph_sb_vseq
      sw_images: ["//sw/device/tests/eg2_periph:eg2_pbf_periph_sb_inject_fail:1:new_rules"]
      en_run_modes: ["sw_test_mode_test_rom"]
      build_mode: "en_eg2_periph"
      run_opts: ["+sw_test_timeout_ns=150_000_000", "+eg2_closes=chip_sw_eg2_pbf_periph_sb:REQ_PBF_13,REQ_PER_10,REQ_PER_11,REQ_PER_13,REQ_PER_15"]
      run_timeout_mins: 480
    }
    {
      name: chip_sw_eg2_pbf_periph_sb_cheriot_inject_fail
      uvm_test_seq: chip_sw_eg2_pbf_periph_sb_vseq
      sw_images: ["//sw/device/tests/eg2_periph:eg2_pbf_periph_sb_cheriot_inject_fail:1:new_rules"]
      en_run_modes: ["sw_test_mode_test_rom"]
      build_mode: "en_eg2_periph"
      run_opts: ["+sw_test_timeout_ns=150_000_000", "+eg2_closes=chip_sw_eg2_pbf_periph_sb:REQ_PBF_13,REQ_PER_10,REQ_PER_11,REQ_PER_13,REQ_PER_15"]
      run_timeout_mins: 480
    }
    {
      name: chip_sw_eg2_pbf_periph_fault_inject_fail
      uvm_test_seq: chip_sw_eg2_pbf_periph_fault_vseq
      sw_images: ["//sw/device/tests/eg2_periph:eg2_pbf_periph_fault_inject_fail:1:new_rules"]
      en_run_modes: ["sw_test_mode_test_rom"]
      build_mode: "en_eg2_periph"
      run_opts: ["+sw_test_timeout_ns=150_000_000", "+eg2_closes=chip_sw_eg2_pbf_periph_fault:REQ_PBF_13"]
      run_timeout_mins: 480
    }
    {
      name: chip_sw_eg2_pbf_periph_fault_cheriot_inject_fail
      uvm_test_seq: chip_sw_eg2_pbf_periph_fault_vseq
      sw_images: ["//sw/device/tests/eg2_periph:eg2_pbf_periph_fault_cheriot_inject_fail:1:new_rules"]
      en_run_modes: ["sw_test_mode_test_rom"]
      build_mode: "en_eg2_periph"
      run_opts: ["+sw_test_timeout_ns=150_000_000", "+eg2_closes=chip_sw_eg2_pbf_periph_fault:REQ_PBF_13"]
      run_timeout_mins: 480
    }
    {
      // The framework smoke tests with the per-peripheral scoreboards and the path check.
      name: chip_sw_eg2_status_smoketest_eg2sb
      uvm_test_seq: chip_sw_eg2_status_smoketest_vseq
      sw_images: ["//sw/device/tests:eg2_status_smoketest:1:new_rules"]
      en_run_modes: ["sw_test_mode_test_rom"]
      build_mode: "en_eg2_periph"
      run_opts: ["+eg2_closes=chip_sw_eg2_status_smoketest:REQ_STE_10"]
      run_timeout_mins: 240
    }
    {
      name: chip_sw_eg2_status_smoketest_cheriot_eg2sb
      uvm_test_seq: chip_sw_eg2_status_smoketest_vseq
      sw_images: ["//sw/device/tests:eg2_status_smoketest_cheriot:1:new_rules"]
      en_run_modes: ["sw_test_mode_test_rom"]
      build_mode: "en_eg2_periph"
      run_opts: ["+eg2_closes=chip_sw_eg2_status_smoketest_cheriot:REQ_STE_10"]
      run_timeout_mins: 240
    }
    {
      name: chip_sw_eg2_dif_smoketest_eg2sb
      uvm_test_seq: chip_sw_eg2_base_vseq
      sw_images: ["//sw/device/tests:eg2_dif_smoketest:1:new_rules"]
      en_run_modes: ["sw_test_mode_test_rom"]
      build_mode: "en_eg2_periph"
      run_opts: ["+eg2_closes=chip_sw_eg2_dif_smoketest:REQ_STE_10"]
      run_timeout_mins: 240
    }
    {
      name: chip_sw_eg2_dif_smoketest_cheriot_eg2sb
      uvm_test_seq: chip_sw_eg2_base_vseq
      sw_images: ["//sw/device/tests:eg2_dif_smoketest_cheriot:1:new_rules"]
      en_run_modes: ["sw_test_mode_test_rom"]
      build_mode: "en_eg2_periph"
      run_opts: ["+eg2_closes=chip_sw_eg2_dif_smoketest_cheriot:REQ_STE_10"]
      run_timeout_mins: 240
    }
    {
      // Must DETECT (REQ_STE_03): +sb_corrupt corrupts one value of one check, announced in the
      // injection registry; the run passes only if that check reports it as `EG2_SB <check>
      // EXPECTED mismatch (injected by sb_corrupt ...)`, and fails with `MISSED injection` if not.
      // Run by `make must-detect`; in no regression list.
      name: chip_sw_eg2_status_smoketest_eg2sb_sb_corrupt_uart0_count
      uvm_test_seq: chip_sw_eg2_status_smoketest_vseq
      sw_images: ["//sw/device/tests:eg2_status_smoketest:1:new_rules"]
      en_run_modes: ["sw_test_mode_test_rom"]
      build_mode: "en_eg2_periph"
      run_opts: ["+eg2_closes=chip_sw_eg2_status_smoketest:REQ_STE_03,REQ_STE_10", "+sb_corrupt=uart0.count"]
      run_timeout_mins: 480
    }
    {
      name: chip_sw_eg2_status_smoketest_eg2sb_sb_corrupt_uart0_item
      uvm_test_seq: chip_sw_eg2_status_smoketest_vseq
      sw_images: ["//sw/device/tests:eg2_status_smoketest:1:new_rules"]
      en_run_modes: ["sw_test_mode_test_rom"]
      build_mode: "en_eg2_periph"
      run_opts: ["+eg2_closes=chip_sw_eg2_status_smoketest:REQ_STE_03,REQ_STE_10", "+sb_corrupt=uart0.item"]
      run_timeout_mins: 480
    }
    {
      name: chip_sw_eg2_status_smoketest_eg2sb_sb_corrupt_rvfi_count
      uvm_test_seq: chip_sw_eg2_status_smoketest_vseq
      sw_images: ["//sw/device/tests:eg2_status_smoketest:1:new_rules"]
      en_run_modes: ["sw_test_mode_test_rom"]
      build_mode: "en_eg2_periph"
