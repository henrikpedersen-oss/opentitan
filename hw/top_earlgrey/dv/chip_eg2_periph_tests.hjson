  regressions: [
    {
      // The peripheral tests with one scoreboard per peripheral (build mode en_eg2_periph): the
      // new EG2 tests, the framework smoke tests and the legacy peripheral tests as `_eg2sb`. The
      // `_inject_fail` builds (`make must-fail`) and the `_sb_corrupt_` runs (`make must-detect`)
      // are run on their own.
