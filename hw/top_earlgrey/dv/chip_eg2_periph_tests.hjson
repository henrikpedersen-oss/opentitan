    {
      // spi_device in flash mode: the test ROM bootstraps the image over SPI (Read SFDP, Read
      // Status, WREN, Page Program and Erase uploads), so spi_device's scoreboard predicts the
      // status and SFDP bytes and checks the uploads the ROM reads back.
      name: chip_sw_uart_tx_rx_bootstrap_eg2sb
      uvm_test_seq: chip_sw_uart_tx_rx_vseq
      sw_images: ["//sw/device/tests:uart_tx_rx_test:1:new_rules"]
      en_run_modes: ["sw_test_mode_test_rom"]
      build_mode: "en_eg2_periph"
      run_opts: ["+use_spi_load_bootstrap=1", "+calibrate_usb_clk=1", "+test_timeout_ns=160_000_000", "+eg2_closes=chip_sw_uart_tx_rx_bootstrap:REQ_PER_10,REQ_PER_12,REQ_PBF_13", "+eg2_sb_required=spi_device"]
      run_timeout_mins: 480
    }
    {
      // Must DETECT (REQ_STE_03): spi_device's n-th predicted item corrupted and announced.
      name: chip_sw_spi_device_tpm_eg2sb_sb_corrupt_spi_device_item
      uvm_test_seq: chip_sw_spi_device_tpm_vseq
      sw_images: ["//sw/device/tests:spi_device_tpm_tx_rx_test:1:new_rules"]
      en_run_modes: ["sw_test_mode_test_rom"]
      build_mode: "en_eg2_periph"
      run_opts: ["+eg2_closes=chip_sw_spi_device_tpm:REQ_STE_03,REQ_PER_12", "+sb_corrupt=spi_device.item"]
      run_timeout_mins: 480
    }
    {
      // Must FAIL with `EG2_SB spi_device item`: the same corruption, not announced.
      name: chip_sw_spi_device_tpm_eg2sb_sb_flip_spi_device_item
      uvm_test_seq: chip_sw_spi_device_tpm_vseq
      sw_images: ["//sw/device/tests:spi_device_tpm_tx_rx_test:1:new_rules"]
      en_run_modes: ["sw_test_mode_test_rom"]
      build_mode: "en_eg2_periph"
      run_opts: ["+eg2_closes=chip_sw_spi_device_tpm:REQ_STE_03,REQ_PER_12", "+eg2_sb_flip=spi_device.item"]
      run_timeout_mins: 480
    }
