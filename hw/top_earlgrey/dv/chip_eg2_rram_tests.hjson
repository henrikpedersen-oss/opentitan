//
// EG2 rram area (eg2_top_verification: status/test_writing_rules.md; spec REQ_RRAM).
// Software in sw/device/tests/eg2_rram/, sequences in env/seq_lib/ (chip_eg2_rram_vseq_list.sv).
// Each test runs in both modes (`_cheriot`); every `_inject_fail` run must FAIL (REQ_STE_03:
// Makefile MUST_FAIL_TESTS) and is in no regression list.
{
  tests: [
    {
      name: chip_sw_rram_host_exec
      uvm_test_seq: chip_sw_eg2_rram_host_exec_vseq
      sw_images: ["//sw/device/tests/eg2_rram:eg2_rram_host_exec:1:new_rules"]
      en_run_modes: ["sw_test_mode_test_rom"]
      build_mode: "en_eg2_cosim"
      run_opts: ["+sw_test_timeout_ns=100_000_000"]
      run_timeout_mins: 240
