//
// EG2 security area (eg2_top_verification: status/test_writing_rules.md; spec REQ_SEC).
// Software in sw/device/tests/eg2_sec/, sequences in env/seq_lib/chip_sw_eg2_sec_vseqs.sv
// (chip_eg2_sec_vseq_list.sv; the SBA sequence and the base in chip_eg2_boot_vseq_list.sv).
// Each test runs in both modes (`_cheriot`). Tests from the test ROM: sw_test_mode_test_rom; tests
// behind the full secure-boot chain: sw_test_mode_mask_rom with the image flag `rom_ext`. Every
// `_inject_fail` run must FAIL (REQ_STE_03: Makefile MUST_FAIL_TESTS) and is in no regression
// list; where the bench has a check of its own, the `_inject_fail` entry also sets
// +eg2_inject_fail=1, which breaks one of the bench's expectations.
{
  tests: [
    {
      name: chip_sw_eg2_lc_rram_rollback
      uvm_test_seq: chip_sw_eg2_lc_rram_rollback_vseq
      sw_images: ["//sw/device/tests/eg2_sec:eg2_lc_rram_rollback:1:new_rules"]
      en_run_modes: ["sw_test_mode_test_rom"]
      build_mode: "en_eg2_cosim"
      run_opts: ["+sw_test_timeout_ns=100_000_000"]
      run_timeout_mins: 480
    }
    {
      name: chip_sw_eg2_lc_rram_rollback_inject_fail
      uvm_test_seq: chip_sw_eg2_lc_rram_rollback_vseq
      sw_images: ["//sw/device/tests/eg2_sec:eg2_lc_rram_rollback_inject_fail:1:new_rules"]
      en_run_modes: ["sw_test_mode_test_rom"]
      build_mode: "en_eg2_cosim"
      run_opts: ["+sw_test_timeout_ns=100_000_000", "+eg2_inject_fail=1"]
      run_timeout_mins: 480
    }
    {
      name: chip_sw_eg2_lc_rram_rollback_cheriot
      uvm_test_seq: chip_sw_eg2_lc_rram_rollback_vseq
