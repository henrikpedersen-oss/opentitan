//
// EG2 secure-boot area (eg2_top_verification: status/test_writing_rules.md; spec REQ_BOOT).
// Software in sw/device/tests/eg2_boot/, sequences in env/seq_lib/ (chip_eg2_boot_vseq_list.sv).
// Every test but chip_sw_eg2_boot_epmp_reset runs behind the full secure-boot chain (mask ROM,
// ROM_EXT, the test as a signed owner image: run mode sw_test_mode_mask_rom, image flag
// `rom_ext`); chip_sw_eg2_boot_outcome_vseq checks each image's outcome as the documents give it
// (+eg2_boot_expect, +eg2_boot_refused_by, +eg2_boot_cheriot). Every `_inject_fail` run must
// FAIL (REQ_STE_03: Makefile MUST_FAIL_TESTS) and is in no regression list.
{
  tests: [
    {
      name: chip_sw_eg2_boot_epmp_reset
      uvm_test_seq: chip_sw_base_vseq
      sw_images: ["//sw/device/tests/eg2_boot:eg2_boot_epmp_reset:0:test_in_rom:new_rules"]
      en_run_modes: ["sw_test_mode_common"]
      build_mode: "en_eg2_cosim"
      run_opts: ["+sw_test_timeout_ns=20_000_000"]
      run_timeout_mins: 480
    }
    {
      name: chip_sw_eg2_boot_epmp_reset_inject_fail
      uvm_test_seq: chip_sw_base_vseq
      sw_images: ["//sw/device/tests/eg2_boot:eg2_boot_epmp_reset_inject_fail:0:test_in_rom:new_rules"]
      en_run_modes: ["sw_test_mode_common"]
      build_mode: "en_eg2_cosim"
      run_opts: ["+sw_test_timeout_ns=20_000_000"]
      run_timeout_mins: 480
    }
    {
      name: chip_sw_eg2_boot_handover_protection
      uvm_test_seq: chip_sw_eg2_boot_handover_protection_vseq
      sw_images: ["//sw/device/tests/eg2_boot:eg2_boot_handover_protection:1:rom_ext"]
      en_run_modes: ["sw_test_mode_mask_rom"]
      build_mode: "en_eg2_cosim"
      run_opts: ["+sw_test_timeout_ns=300_000_000", "+use_jtag_dmi=1"]
      run_timeout_mins: 480
    }
    {
      name: chip_sw_eg2_boot_handover_protection_inject_fail
      uvm_test_seq: chip_sw_eg2_boot_handover_protection_vseq
      sw_images: ["//sw/device/tests/eg2_boot:eg2_boot_handover_protection_inject_fail:1:rom_ext"]
      en_run_modes: ["sw_test_mode_mask_rom"]
      build_mode: "en_eg2_cosim"
      run_opts: ["+sw_test_timeout_ns=300_000_000", "+use_jtag_dmi=1"]
