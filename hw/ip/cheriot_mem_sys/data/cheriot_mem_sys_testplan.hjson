{
  name: "cheriot_mem_sys"

  // The common testplans mirror the test lists imported by cheriot_mem_sys_sim_cfg.hjson.
  // mem_testplan is not imported: the only memory window, `revbm`, has no registers, so reggen
  // emits no RAL model and there is no RAL memory to walk.
  import_testplans: ["hw/dv/tools/dvsim/testplans/csr_testplan.hjson",
                     "hw/dv/tools/dvsim/testplans/alert_test_testplan.hjson",
                     "hw/dv/tools/dvsim/testplans/intr_test_testplan.hjson",
                     "hw/dv/tools/dvsim/testplans/tl_device_access_types_testplan.hjson",
                     "cheriot_mem_sys_sec_cm_testplan.hjson"]

  // Every feature test is checked by the C reference model of the subsystem (dv/cmodel,
  // written from the design documents): each completed access on the core data port, both bitmap
  // ports and `regs` (data, tag, error), and the meta SRAM word by word at the end. Its vseq
  // (dv/env/seq_lib/cheriot_mem_sys_<name>_vseq.sv) describes the stimulus in full.
  testpoints: [
    {
      name: directed_closure
      desc: '''
        Pipelined WTRC handoffs and malformed NVM corners; the mode/region/core
        access matrix; combined bitmap/error/integrity causes; the non-power-of-two
        bitmap boundaries; ambiguous external overlaps; invalidation-write errors;
        INTR_TEST byte-enable refusal; legal address, data and source-ID sweeps.
        Every expected response and tag comes from external monitor history and the
        independent model. Internal coverage observes only. See each sequence header
        for its requirements; passing a sequence does not waive unhit bins.
      '''
      stage: V2
      tests: ["cheriot_mem_sys_wtrc_handoffs", "cheriot_mem_sys_nvm_corners",
              "cheriot_mem_sys_core_matrix", "cheriot_mem_sys_revocation_causes",
              "cheriot_mem_sys_bitmap_boundaries", "cheriot_mem_sys_ambiguous_overlaps",
              "cheriot_mem_sys_invalidation_error", "cheriot_mem_sys_csr_byte_enable",
              "cheriot_mem_sys_toggle_sweeps"]
    }
    {
      name: smoke
      desc: '''
            The registers' reset values; ePMP mode out of reset with no meta SRAM access and no
            tag; in CHERIoT mode a capability store sets a tag, a capability load returns it and a
            data store clears it.
            '''
      stage: V1
      tests: ["cheriot_mem_sys_tag_smoke"]
    }
    {
      name: tag_store_load
      desc: '''
            Capability stores set the tag of their granule and capability loads return it, in the
            SRAM and the NVM, at the region boundaries and at random granules; untagged memory has
            no tag and never reaches the meta SRAM.
            '''
      stage: V2
      tests: ["cheriot_mem_sys_tag_store_load"]
    }
    {
      name: tag_clear_subword
      desc: '''
            Every non-capability write (byte, halfword, word, partial word) clears the tag of the
            granule it touches and of no other.
            '''
      stage: V2
      tests: ["cheriot_mem_sys_tag_clear_subword"]
    }
    {
      name: cap_load_hint
      desc: '''
            Only a hinted, 64-bit-aligned load in CHERIoT mode to tagged memory looks its tag up;
            the second word carries the first word's tag; two outstanding accesses under
            back-pressure.
            '''
      stage: V2
      tests: ["cheriot_mem_sys_cap_load_hint"]
    }
    {
      name: access_check
      desc: '''
            The bitmap window and the core's TRVK port reach only the revocation bitmap, with
            full-word, word-aligned Get and PutFullData; the tag regions are not mapped; no alert.
            '''
      stage: V2
      tests: ["cheriot_mem_sys_access_check"]
    }
    {
      name: mode_gating
      desc: '''
            Every `cheriot_ena_i` value other than MuBi4True (MuBi4False and the 14 invalid
            encodings) blocks the meta SRAM from every port, issues no tag lookup and ignores
            TBRE_START.
            '''
      stage: V2
      tests: ["cheriot_mem_sys_mode_gating"]
    }
    {
      name: rmw
      desc: '''
            A tag write changes exactly its bit of the meta word under heavy traffic to one word,
            and skips the write-back when the bit already has the value; the core and the
            revocation engine writing bits of the same word at once lose no update.
            '''
      stage: V2
      tests: ["cheriot_mem_sys_rmw_same_word", "cheriot_mem_sys_rmw_core_tbre_same_word"]
    }
    {
      name: nvm_cap_store
      desc: '''
            A capability store to the NVM is read and compared (WTRC): it sets the tag only if the
            NVM holds both words, otherwise answers d_error and leaves the tag; plain stores are
            refused and clear the tag; programming the NVM leaves it; stores the core cannot
            produce raise fatal_fault.
            '''
      stage: V2
      tests: ["cheriot_mem_sys_nvm_cap_store"]
    }
    {
      name: tbre_sweep
      desc: '''
            A sweep clears exactly the tagged, non-sealing capabilities whose base is revoked, over
            whole regions, sub-ranges and single capabilities, for every exponent and both base
            corrections, at the bitmap's edges.
            '''
      stage: V2
      tests: ["cheriot_mem_sys_tbre_sweep", "cheriot_mem_sys_tbre_base_decode"]
    }
    {
      name: tbre_registers
      desc: '''
            TBRE_START, TBRE_REGWEN, TBRE_STATUS and TBRE_EPOCH: accepted and ignored starts,
            start_err and sweep_err, the lock while a sweep runs, a sweep clamped at the top of its
            region, refused partial writes and unmapped offsets, the epoch's count.
            '''
      stage: V2
      tests: ["cheriot_mem_sys_tbre_csr", "cheriot_mem_sys_tbre_epoch"]
    }
    {
      name: tbre_concurrent
      desc: '''
            Core traffic and bitmap writes during a sweep; core writes to capabilities the engine
            has in flight stop their clear (the snoop window).
            '''
      stage: V2
      tests: ["cheriot_mem_sys_tbre_concurrent", "cheriot_mem_sys_tbre_snoop_window"]
    }
    {
      name: tbre_intr
      desc: '''
            The tbre_done interrupt at the end of every sweep (also a failed one), INTR_STATE as a
            level, INTR_ENABLE masking, INTR_TEST, none for an ignored start.
            '''
      stage: V2
      tests: ["cheriot_mem_sys_tbre_intr"]
    }
    {
      name: alert_test_reg
      desc: '''
            ALERT_TEST.fatal_fault raises one handshake while ALERT_TEST.regwen is set; clearing
            regwen disables alert testing until reset.
            '''
      stage: V2
      tests: ["cheriot_mem_sys_alert_test_reg"]
    }
    {
      name: errors
      desc: '''
            Every error path: a register command integrity fault; errors on the data path (no
            alert); device and integrity errors on the meta SRAM path (fatal_fault); faults on the
            revocation engine's reads and bitmap lookups (sweep_err, not counted, the capability
            kept or revoked as documented).
            '''
      stage: V2
      tests: ["cheriot_mem_sys_err_csr_intg", "cheriot_mem_sys_err_data_path",
              "cheriot_mem_sys_err_meta_intg", "cheriot_mem_sys_err_tag_path",
              "cheriot_mem_sys_err_tbre_read", "cheriot_mem_sys_err_tbre_revbm"]
    }
    {
      name: mixed_random
      desc: '''
            Random core traffic of every kind against sweeps of random ranges, concentrated on a
            few meta words so that the core, the engine and the bitmap meet.
            '''
      stage: V2
      tests: ["cheriot_mem_sys_mixed_random"]
    }
    {
      name: cmodel_random
      desc: '''
            Constrained-random traffic on every port on Earl Grey 2's address map: data and
            capability loads and stores to the SRAM, the NVM and untagged memory, capability stores
            to the NVM that match and that do not, bitmap reads and writes on both bitmap ports,
            sweeps and register reads; `cheriot_ena_i` in both modes and invalid encodings.
            '''
      stage: V2
      tests: ["cheriot_mem_sys_cmodel_random"]
    }
    {
      name: cmodel_random_inject_fail
      desc: '''
            The C model's check is shown to fail: one read response handed to the model is
            corrupted (one bit flipped), and the test must fail at that access with the model's
            mismatch.
            '''
      stage: V2
      tests: ["cheriot_mem_sys_cmodel_random_inject_fail"]
    }
    {
      name: reset_mid_sweep
      desc: "Reset during an active externally observed sweep; reset CSRs, retained memory and subsequent reads/sweep. REQ_CMS_15 block part."
      stage: V2
      tests: ["cheriot_mem_sys_reset"]
    }
    {
      name: tbre_store_race
      desc: "Rewrite a revoked capability with a live one at offsets from external TBRE requests and responses. REQ_TBRE_24–27, 39."
      stage: V2
      tests: ["cheriot_mem_sys_tbre_store_race"]
    }
    {
      name: random_long
      desc: "40,000 mixed operations with concurrent sweeps; the same independent checking as mixed_random."
      stage: V2
      tests: ["cheriot_mem_sys_random_long"]
    }
    {
      name: latency_backpressure
      desc: "External core/crossbar latency, TBRE outstanding reads and progress under bounded backpressure. REQ_CMS_07 known extra-cycle gap; internal verdict-cycle checks are not observable at this boundary."
      stage: V2
      tests: ["cheriot_mem_sys_latency", "cheriot_mem_sys_trvk_backpressure"]
    }
    {
      name: trvk_fault
      desc: "Seven write-only, single-cycle TRVK fault actuators; externally observed tag survival and alert. REQ_CMS_02 remains a known LOGIC.SHADOW gap, not a pass."
      stage: V2
      tests: ["cheriot_mem_sys_trvk_fault_verdict", "cheriot_mem_sys_trvk_fault_tag_out", "cheriot_mem_sys_trvk_fault_bit_select", "cheriot_mem_sys_trvk_fault_req_required", "cheriot_mem_sys_trvk_fault_out_of_range", "cheriot_mem_sys_trvk_fault_sealing", "cheriot_mem_sys_trvk_fault_align"]
    }
    {
      name: checker_negative
      desc: "Named deliberate checker corruptions must be reached and fail their intended comparisons. MUBI/lockstep twins are not ported because their RTL countermeasures are absent."
      stage: V2
      tests: ["cheriot_mem_sys_cap_load_hint_corrupt_load_tag", "cheriot_mem_sys_cap_load_hint_corrupt_sticky_tag", "cheriot_mem_sys_tbre_sweep_corrupt_sweep", "cheriot_mem_sys_access_check_corrupt_revbm", "cheriot_mem_sys_access_check_corrupt_err", "cheriot_mem_sys_tag_store_load_corrupt_data", "cheriot_mem_sys_tbre_store_race_corrupt_race", "cheriot_mem_sys_tbre_epoch_corrupt_epoch", "cheriot_mem_sys_latency_corrupt_latency", "cheriot_mem_sys_trvk_fault_corrupt_trvk", "cheriot_mem_sys_trvk_backpressure_corrupt_backpressure"]
    }
  ]

  covergroups: [
    {
      name: core_access_cg
      desc: '''
            Every core access: opcode, size, tag (store tag or load hint), mode (CHERIoT, ePMP,
            invalid), region (SRAM, NVM, untagged, error range), error and response tag, crossed.
            '''
    }
    {
      name: bitmap_access_cg
      desc: '''
            The bitmap ports (software window, core TRVK port): opcode and error, crossed.
            '''
    }
    {
      name: cms_sweep_cap_cg
      desc: "Independent swept capability candidates, sealing, base class, bitmap, exponent and correction."
    }
    {
      name: cms_tbre_start_cg
      desc: "Accepted/ignored start reasons, region and clamping."
    }
    {
      name: cms_tbre_end_cg
      desc: "Sweep fault alternatives, denied reads, region and interrupt enable."
    }
    {
      name: cms_sweep_snoop_cg
      desc: "Core stores relative to external sweep read handshakes; unknown boundary classified around."
    }
    {
      name: cms_nvm_cap_cg
      desc: "NVM capability store word, outcome and independent prior tag."
    }
    {
      name: cms_meta_access_cg
      desc: "Bitmap-window legality by requester and operation."
    }
    {
      name: cms_sweep_race_cg
      desc: "Core stores outside/in the sweep range, sharing a meta word, or possibly revoked."
    }
    {
      name: tag_filter_req_cg
      desc: "RTL coverage only: tag-filter request and lookup decision."
    }
    {
      name: tag_filter_rsp_cg
      desc: "RTL coverage only: response tag, lookup and error."
    }
    {
      name: rmw_cg
      desc: "RTL coverage only: RMW fill, change, writeback and errors."
    }
    {
      name: tbre_mover_cg
      desc: "RTL coverage only: mover state, snoop, stale capability and faults."
    }
    {
      name: access_check_cg
      desc: "RTL coverage only: mode, range, operation and forwarding."
    }
    {
      name: cheriot_top_cg
      desc: "RTL coverage only: starts, arbitration, races, done, interrupt and fatal faults."
    }
    {
      name: wtrc_cg
      desc: "RTL coverage only: capability word matching, tag writes and errors."
    }
    {
      name: trvk_cg
      desc: "RTL coverage only: bitmap bit and position, sealing, lookup/error decisions, outstanding lookup and returned tag. Adapted from the current Ibex repository."
    }
    {
      name: trvk_window_cg
      desc: "RTL coverage only: in-window, past-size and beyond-power-of-two base classes. Generated only for a non-power-of-two bitmap; absent by construction in cms_map."
    }
  ]
}
