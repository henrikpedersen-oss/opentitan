name: "lowrisc:dv:cheriot_mem_sys_env:0.1"
description: "CHERIOT_MEM_SYS DV UVM environment"
filesets:
  files_dv:
    depend:
      - lowrisc:dv:ralgen
      - lowrisc:dv:cip_lib
      - lowrisc:dv:mem_model
      - lowrisc:dv:cheriot_mem_sys_cmodel
      - lowrisc:dv:cheriot_mem_sys_core_agent
    files:
      - cheriot_mem_sys_env_pkg.sv
      - cheriot_mem_sys_env_cfg.sv: {is_include_file: true}
      - cheriot_mem_sys_env_cov.sv: {is_include_file: true}
      - cheriot_mem_sys_exp_items.sv: {is_include_file: true}
      - cheriot_mem_sys_mem_backdoor.sv: {is_include_file: true}
      - cheriot_mem_sys_virtual_sequencer.sv: {is_include_file: true}
      - cheriot_mem_sys_ref_model.sv: {is_include_file: true}
      - cheriot_mem_sys_scoreboard.sv: {is_include_file: true}
      - cheriot_mem_sys_env.sv: {is_include_file: true}
      - seq_lib/cheriot_mem_sys_vseq_list.sv: {is_include_file: true}
      - seq_lib/cheriot_mem_sys_mem_device_seq.sv: {is_include_file: true}
      - seq_lib/cheriot_mem_sys_tl_host_seq.sv: {is_include_file: true}
      - seq_lib/cheriot_mem_sys_base_vseq.sv: {is_include_file: true}
      - seq_lib/cheriot_mem_sys_common_vseq.sv: {is_include_file: true}
      - seq_lib/cheriot_mem_sys_tag_smoke_vseq.sv: {is_include_file: true}
      - seq_lib/cheriot_mem_sys_tag_store_load_vseq.sv: {is_include_file: true}
      - seq_lib/cheriot_mem_sys_tag_clear_subword_vseq.sv: {is_include_file: true}
      - seq_lib/cheriot_mem_sys_cap_load_hint_vseq.sv: {is_include_file: true}
      - seq_lib/cheriot_mem_sys_access_check_vseq.sv: {is_include_file: true}
      - seq_lib/cheriot_mem_sys_mode_gating_vseq.sv: {is_include_file: true}
      - seq_lib/cheriot_mem_sys_rmw_same_word_vseq.sv: {is_include_file: true}
      - seq_lib/cheriot_mem_sys_rmw_core_tbre_same_word_vseq.sv: {is_include_file: true}
      - seq_lib/cheriot_mem_sys_nvm_cap_store_vseq.sv: {is_include_file: true}
      - seq_lib/cheriot_mem_sys_tbre_sweep_vseq.sv: {is_include_file: true}
      - seq_lib/cheriot_mem_sys_tbre_base_decode_vseq.sv: {is_include_file: true}
      - seq_lib/cheriot_mem_sys_tbre_csr_vseq.sv: {is_include_file: true}
      - seq_lib/cheriot_mem_sys_tbre_concurrent_vseq.sv: {is_include_file: true}
      - seq_lib/cheriot_mem_sys_tbre_snoop_window_vseq.sv: {is_include_file: true}
      - seq_lib/cheriot_mem_sys_tbre_epoch_vseq.sv: {is_include_file: true}
      - seq_lib/cheriot_mem_sys_tbre_intr_vseq.sv: {is_include_file: true}
      - seq_lib/cheriot_mem_sys_alert_test_reg_vseq.sv: {is_include_file: true}
      - seq_lib/cheriot_mem_sys_err_csr_intg_vseq.sv: {is_include_file: true}
      - seq_lib/cheriot_mem_sys_err_data_path_vseq.sv: {is_include_file: true}
      - seq_lib/cheriot_mem_sys_err_meta_intg_vseq.sv: {is_include_file: true}
      - seq_lib/cheriot_mem_sys_err_tag_path_vseq.sv: {is_include_file: true}
      - seq_lib/cheriot_mem_sys_err_tbre_read_vseq.sv: {is_include_file: true}
      - seq_lib/cheriot_mem_sys_err_tbre_revbm_vseq.sv: {is_include_file: true}
      - seq_lib/cheriot_mem_sys_mixed_random_vseq.sv: {is_include_file: true}
      - seq_lib/cheriot_mem_sys_cmodel_random_vseq.sv: {is_include_file: true}
    file_type: systemVerilogSource

generate:
  ral:
    generator: ralgen
    parameters:
      name: cheriot_mem_sys
      ip_hjson: ../../data/cheriot_mem_sys.hjson
    position: prepend

targets:
  default:
    filesets:
      - files_dv
    generate:
      - "!chip_level ? (ral)"
