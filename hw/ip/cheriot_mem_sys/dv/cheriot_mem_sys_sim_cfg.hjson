{
  // Name of the sim cfg - typically same as the name of the DUT.
  name: cheriot_mem_sys

  // Top level dut name (sv module).
  dut: cheriot_mem_sys

  // Top level testbench name (sv module).
  tb: tb

  // Simulator used to sign off this block
  tool: vcs

  // Fusesoc core file used for building the file list.
  fusesoc_core: lowrisc:dv:cheriot_mem_sys_sim:0.1

  // Testplan hjson file.
  testplan: "{proj_root}/hw/ip/cheriot_mem_sys/data/cheriot_mem_sys_testplan.hjson"

  // RAL spec - used to generate the RAL model.
  ral_spec: "{proj_root}/hw/ip/cheriot_mem_sys/data/cheriot_mem_sys.hjson"

  // Import additional common sim cfg files.
  //
  // mem_tests is not imported: `revbm` has no registers, so reggen emits no RAL model for it and
  // there is no RAL memory to walk. stress_tests is not imported: no sequence to stress yet.
  import_cfgs: [// Project wide common sim cfg file
                "{proj_root}/hw/dv/tools/dvsim/common_sim_cfg.hjson",
                // Common CIP test lists
                "{proj_root}/hw/dv/tools/dvsim/tests/csr_tests.hjson",
                "{proj_root}/hw/dv/tools/dvsim/tests/alert_test.hjson",
                "{proj_root}/hw/dv/tools/dvsim/tests/intr_test.hjson",
                "{proj_root}/hw/dv/tools/dvsim/tests/tl_access_tests.hjson"]

  // Add additional tops for simulation.
  sim_tops: ["cheriot_mem_sys_bind"]

  // Default iterations for all tests - each test entry can override this.
  reseed: 1

  // Default UVM test and seq class name.
  uvm_test: cheriot_mem_sys_base_test
  uvm_test_seq: cheriot_mem_sys_base_vseq

  // List of test specifications.
  // The cms testbench's small address map (16 KiB SRAM, 8 KiB NVM) for the tests ported from it.
  build_modes: [
    {
      name: cms_map
      build_opts: ["+define+CHERIOT_MEM_SYS_CMS_MAP"]
    }
  ]
  // The coverage configuration of each build mode (common_sim_cfg.hjson): the default's.
  cms_map_vcs_cov_cfg_file: "{default_vcs_cov_cfg_file}"
  cms_map_xcelium_cov_cfg_file: "{default_xcelium_cov_cfg_file}"

  tests: [
    // The feature tests (tests/cheriot_mem_sys_*_test.sv, one per file, each running its vseq),
    // checked by the C reference model. All but cmodel_random use the small address map (build
    // mode cms_map).
    {
      name: cheriot_mem_sys_tag_smoke
      uvm_test: cheriot_mem_sys_tag_smoke_test
      build_mode: cms_map
      reseed: 1
    }
    {
      name: cheriot_mem_sys_tag_store_load
      uvm_test: cheriot_mem_sys_tag_store_load_test
      build_mode: cms_map
      reseed: 3
    }
    {
      name: cheriot_mem_sys_tag_clear_subword
      uvm_test: cheriot_mem_sys_tag_clear_subword_test
      build_mode: cms_map
      reseed: 2
    }
    {
      name: cheriot_mem_sys_cap_load_hint
      uvm_test: cheriot_mem_sys_cap_load_hint_test
      build_mode: cms_map
      reseed: 3
    }
    {
      name: cheriot_mem_sys_access_check
      uvm_test: cheriot_mem_sys_access_check_test
      build_mode: cms_map
      reseed: 3
    }
    {
      name: cheriot_mem_sys_mode_gating
      uvm_test: cheriot_mem_sys_mode_gating_test
      build_mode: cms_map
      reseed: 2
    }
    {
      name: cheriot_mem_sys_rmw_same_word
      uvm_test: cheriot_mem_sys_rmw_same_word_test
      build_mode: cms_map
      reseed: 5
    }
    {
      name: cheriot_mem_sys_rmw_core_tbre_same_word
      uvm_test: cheriot_mem_sys_rmw_core_tbre_same_word_test
      build_mode: cms_map
      reseed: 5
    }
    {
      name: cheriot_mem_sys_tbre_sweep
      uvm_test: cheriot_mem_sys_tbre_sweep_test
      build_mode: cms_map
      reseed: 3
    }
    {
      name: cheriot_mem_sys_tbre_base_decode
      uvm_test: cheriot_mem_sys_tbre_base_decode_test
      build_mode: cms_map
      reseed: 5
    }
    {
      name: cheriot_mem_sys_tbre_csr
      uvm_test: cheriot_mem_sys_tbre_csr_test
      build_mode: cms_map
      reseed: 2
    }
    {
      name: cheriot_mem_sys_tbre_concurrent
      uvm_test: cheriot_mem_sys_tbre_concurrent_test
      build_mode: cms_map
      reseed: 5
    }
    {
      name: cheriot_mem_sys_tbre_snoop_window
      uvm_test: cheriot_mem_sys_tbre_snoop_window_test
      build_mode: cms_map
      reseed: 5
    }
    {
      name: cheriot_mem_sys_mixed_random
      uvm_test: cheriot_mem_sys_mixed_random_test
      build_mode: cms_map
      reseed: 20
    }
    {
      name: cheriot_mem_sys_alert_test_reg
      uvm_test: cheriot_mem_sys_alert_test_reg_test
      build_mode: cms_map
      reseed: 1
    }
    {
      name: cheriot_mem_sys_err_csr_intg
      uvm_test: cheriot_mem_sys_err_csr_intg_test
      build_mode: cms_map
      reseed: 1
    }
    {
      name: cheriot_mem_sys_err_data_path
      uvm_test: cheriot_mem_sys_err_data_path_test
      build_mode: cms_map
      reseed: 2
    }
    {
      name: cheriot_mem_sys_err_meta_intg
      uvm_test: cheriot_mem_sys_err_meta_intg_test
      build_mode: cms_map
      reseed: 2
    }
    {
      name: cheriot_mem_sys_err_tag_path
      uvm_test: cheriot_mem_sys_err_tag_path_test
      build_mode: cms_map
      reseed: 2
    }
    {
      name: cheriot_mem_sys_err_tbre_read
      uvm_test: cheriot_mem_sys_err_tbre_read_test
      build_mode: cms_map
      reseed: 3
    }
    {
      name: cheriot_mem_sys_err_tbre_revbm
      uvm_test: cheriot_mem_sys_err_tbre_revbm_test
      build_mode: cms_map
      reseed: 2
    }
    {
      name: cheriot_mem_sys_nvm_cap_store
      uvm_test: cheriot_mem_sys_nvm_cap_store_test
      build_mode: cms_map
      reseed: 5
    }
    {
      name: cheriot_mem_sys_tbre_epoch
      uvm_test: cheriot_mem_sys_tbre_epoch_test
      build_mode: cms_map
      reseed: 3
    }
    {
      name: cheriot_mem_sys_tbre_intr
      uvm_test: cheriot_mem_sys_tbre_intr_test
      build_mode: cms_map
      reseed: 3
    }
    // Constrained-random traffic on every port, on Earl Grey 2's address map (testpoint
    // cmodel_random).
    {
      name: cheriot_mem_sys_cmodel_random
      uvm_test: cheriot_mem_sys_cmodel_random_test
      reseed: 10
    }
    // The model's check shown to fail: the 50th compared read reaches the model with one bit
    // flipped, and the test must fail with its mismatch (testpoint cmodel_random_inject_fail).
    {
      name: cheriot_mem_sys_cmodel_random_inject_fail
      uvm_test: cheriot_mem_sys_cmodel_random_test
      run_opts: ["+cheriot_mem_sys_cmodel_corrupt=50"]
      reseed: 1
    }
  ]

  // List of regressions.
  regressions: [
    {
      name: smoke
      tests: ["cheriot_mem_sys_tag_smoke"]
    }
    {
      name: feature
      tests: ["cheriot_mem_sys_tag_smoke", "cheriot_mem_sys_tag_store_load", "cheriot_mem_sys_tag_clear_subword", "cheriot_mem_sys_cap_load_hint", "cheriot_mem_sys_access_check", "cheriot_mem_sys_mode_gating", "cheriot_mem_sys_rmw_same_word", "cheriot_mem_sys_rmw_core_tbre_same_word", "cheriot_mem_sys_tbre_sweep", "cheriot_mem_sys_tbre_base_decode", "cheriot_mem_sys_tbre_csr", "cheriot_mem_sys_tbre_concurrent", "cheriot_mem_sys_tbre_snoop_window", "cheriot_mem_sys_mixed_random", "cheriot_mem_sys_alert_test_reg", "cheriot_mem_sys_err_csr_intg", "cheriot_mem_sys_err_data_path", "cheriot_mem_sys_err_meta_intg", "cheriot_mem_sys_err_tag_path", "cheriot_mem_sys_err_tbre_read", "cheriot_mem_sys_err_tbre_revbm", "cheriot_mem_sys_nvm_cap_store", "cheriot_mem_sys_tbre_epoch", "cheriot_mem_sys_tbre_intr", "cheriot_mem_sys_cmodel_random", "cheriot_mem_sys_cmodel_random_inject_fail"]
    }
  ]
}
