{
  // Name of the sim cfg - typically same as the name of the DUT.
  name: cheriot_mem_sys

  // Top level dut name (sv module).
  dut: cheriot_mem_sys

  // Top level testbench name (sv module).
  tb: tb

  // Simulator used to sign off this block
  tool: vcs

  // Fusesoc core file used for building the file list.
  fusesoc_core: lowrisc:dv:cheriot_mem_sys_sim:0.1

  // Testplan hjson file.
  testplan: "{proj_root}/hw/ip/cheriot_mem_sys/data/cheriot_mem_sys_testplan.hjson"

  // RAL spec - used to generate the RAL model.
  ral_spec: "{proj_root}/hw/ip/cheriot_mem_sys/data/cheriot_mem_sys.hjson"

  // Import additional common sim cfg files.
  //
  // mem_tests is not imported: `revbm` has no registers, so reggen emits no RAL model for it and
  // there is no RAL memory to walk. stress_tests is not imported: no sequence to stress yet.
  import_cfgs: [// Project wide common sim cfg file
                "{proj_root}/hw/dv/tools/dvsim/common_sim_cfg.hjson",
                // Common CIP test lists
                "{proj_root}/hw/dv/tools/dvsim/tests/csr_tests.hjson",
                "{proj_root}/hw/dv/tools/dvsim/tests/alert_test.hjson",
                "{proj_root}/hw/dv/tools/dvsim/tests/intr_test.hjson",
                "{proj_root}/hw/dv/tools/dvsim/tests/tl_access_tests.hjson"]

  // Add additional tops for simulation.
  sim_tops: ["cheriot_mem_sys_bind"]

  // Default iterations for all tests - each test entry can override this.
  reseed: 1

  // Default UVM test and seq class name.
  uvm_test: cheriot_mem_sys_base_test
  uvm_test_seq: cheriot_mem_sys_base_vseq

  // List of test specifications.
  // The cms testbench's small address map (16 KiB SRAM, 8 KiB NVM) for the tests ported from it.
  build_modes: [
    {
      name: cms_map
      build_opts: ["+define+CHERIOT_MEM_SYS_CMS_MAP"]
    }
  ]

  tests: [
    // The directed tests of the cms testbench (cms/tb/cms_tests.svh), ported (cheriot_mem_sys_cms_vseq):
    // its small address map (build mode cms_map), the C model as the checker, the cms seed counts.
    {
      name: cheriot_mem_sys_cms_smoke
      uvm_test_seq: cheriot_mem_sys_cms_vseq
      build_mode: cms_map
      run_opts: ["+en_scb=0", "+cheriot_mem_sys_cmodel=1", "+cms_test=cms_smoke"]
      reseed: 1
    }
    {
      name: cheriot_mem_sys_cms_tag_store_load
      uvm_test_seq: cheriot_mem_sys_cms_vseq
      build_mode: cms_map
      run_opts: ["+en_scb=0", "+cheriot_mem_sys_cmodel=1", "+cms_test=cms_tag_store_load"]
      reseed: 3
    }
    {
      name: cheriot_mem_sys_cms_tag_clear_subword
      uvm_test_seq: cheriot_mem_sys_cms_vseq
      build_mode: cms_map
      run_opts: ["+en_scb=0", "+cheriot_mem_sys_cmodel=1", "+cms_test=cms_tag_clear_subword"]
      reseed: 2
    }
    {
      name: cheriot_mem_sys_cms_cap_load_hint
      uvm_test_seq: cheriot_mem_sys_cms_vseq
      build_mode: cms_map
      run_opts: ["+en_scb=0", "+cheriot_mem_sys_cmodel=1", "+cms_test=cms_cap_load_hint"]
      reseed: 3
    }
    {
      name: cheriot_mem_sys_cms_access_check
      uvm_test_seq: cheriot_mem_sys_cms_vseq
      build_mode: cms_map
      run_opts: ["+en_scb=0", "+cheriot_mem_sys_cmodel=1", "+cms_test=cms_access_check"]
      reseed: 3
    }
    {
      name: cheriot_mem_sys_cms_mode_gating
      uvm_test_seq: cheriot_mem_sys_cms_vseq
      build_mode: cms_map
      run_opts: ["+en_scb=0", "+cheriot_mem_sys_cmodel=1", "+cms_test=cms_mode_gating"]
      reseed: 2
    }
    {
      name: cheriot_mem_sys_cms_rmw_same_word
      uvm_test_seq: cheriot_mem_sys_cms_vseq
      build_mode: cms_map
      run_opts: ["+en_scb=0", "+cheriot_mem_sys_cmodel=1", "+cms_test=cms_rmw_same_word"]
      reseed: 5
    }
    {
      name: cheriot_mem_sys_cms_rmw_core_tbre_same_word
      uvm_test_seq: cheriot_mem_sys_cms_vseq
      build_mode: cms_map
      run_opts: ["+en_scb=0", "+cheriot_mem_sys_cmodel=1", "+cms_test=cms_rmw_core_tbre_same_word"]
      reseed: 5
    }
    {
      name: cheriot_mem_sys_cms_tbre_sweep
      uvm_test_seq: cheriot_mem_sys_cms_vseq
      build_mode: cms_map
      run_opts: ["+en_scb=0", "+cheriot_mem_sys_cmodel=1", "+cms_test=cms_tbre_sweep"]
      reseed: 3
    }
    {
      name: cheriot_mem_sys_cms_tbre_base_decode
      uvm_test_seq: cheriot_mem_sys_cms_vseq
      build_mode: cms_map
      run_opts: ["+en_scb=0", "+cheriot_mem_sys_cmodel=1", "+cms_test=cms_tbre_base_decode"]
      reseed: 5
    }
    {
      name: cheriot_mem_sys_cms_tbre_csr
      uvm_test_seq: cheriot_mem_sys_cms_vseq
      build_mode: cms_map
      run_opts: ["+en_scb=0", "+cheriot_mem_sys_cmodel=1", "+cms_test=cms_tbre_csr"]
      reseed: 2
    }
    {
      name: cheriot_mem_sys_cms_tbre_concurrent
      uvm_test_seq: cheriot_mem_sys_cms_vseq
      build_mode: cms_map
      run_opts: ["+en_scb=0", "+cheriot_mem_sys_cmodel=1", "+cms_test=cms_tbre_concurrent"]
      reseed: 5
    }
    {
      name: cheriot_mem_sys_cms_tbre_snoop_window
      uvm_test_seq: cheriot_mem_sys_cms_vseq
      build_mode: cms_map
      run_opts: ["+en_scb=0", "+cheriot_mem_sys_cmodel=1", "+cms_test=cms_tbre_snoop_window"]
      reseed: 5
    }
    {
      name: cheriot_mem_sys_cms_random
      uvm_test_seq: cheriot_mem_sys_cms_vseq
      build_mode: cms_map
      run_opts: ["+en_scb=0", "+cheriot_mem_sys_cmodel=1", "+cms_test=cms_random"]
      reseed: 20
    }
    {
      name: cheriot_mem_sys_smoke
      uvm_test_seq: cheriot_mem_sys_smoke_vseq
    }
    {
      name: cheriot_mem_sys_cms_alert_test
      uvm_test_seq: cheriot_mem_sys_cms_vseq
      build_mode: cms_map
      run_opts: ["+en_scb=0", "+cheriot_mem_sys_cmodel=1", "+cms_test=cms_alert_test"]
      reseed: 1
    }
    {
      name: cheriot_mem_sys_cms_err_csr_intg
      uvm_test_seq: cheriot_mem_sys_cms_vseq
      build_mode: cms_map
      run_opts: ["+en_scb=0", "+cheriot_mem_sys_cmodel=1", "+cms_test=cms_err_csr_intg"]
      reseed: 1
    }
    {
      name: cheriot_mem_sys_cms_err_data_path
      uvm_test_seq: cheriot_mem_sys_cms_vseq
      build_mode: cms_map
      run_opts: ["+en_scb=0", "+cheriot_mem_sys_cmodel=1", "+cms_test=cms_err_data_path"]
      reseed: 2
    }
    {
      name: cheriot_mem_sys_cms_err_meta_intg
      uvm_test_seq: cheriot_mem_sys_cms_vseq
      build_mode: cms_map
      run_opts: ["+en_scb=0", "+cheriot_mem_sys_cmodel=1", "+cms_test=cms_err_meta_intg"]
      reseed: 2
    }
    {
      name: cheriot_mem_sys_cms_err_tag_path
      uvm_test_seq: cheriot_mem_sys_cms_vseq
      build_mode: cms_map
      run_opts: ["+en_scb=0", "+cheriot_mem_sys_cmodel=1", "+cms_test=cms_err_tag_path"]
      reseed: 2
    }
    {
      name: cheriot_mem_sys_cms_err_tbre_read
      uvm_test_seq: cheriot_mem_sys_cms_vseq
      build_mode: cms_map
      run_opts: ["+en_scb=0", "+cheriot_mem_sys_cmodel=1", "+cms_test=cms_err_tbre_read"]
      reseed: 3
    }
    {
      name: cheriot_mem_sys_cms_err_tbre_revbm
      uvm_test_seq: cheriot_mem_sys_cms_vseq
      build_mode: cms_map
      run_opts: ["+en_scb=0", "+cheriot_mem_sys_cmodel=1", "+cms_test=cms_err_tbre_revbm"]
      reseed: 2
    }
    {
      name: cheriot_mem_sys_cms_nvm_cap_store
      uvm_test_seq: cheriot_mem_sys_cms_vseq
      build_mode: cms_map
      run_opts: ["+en_scb=0", "+cheriot_mem_sys_cmodel=1", "+cms_test=cms_nvm_cap_store"]
      reseed: 5
    }
    {
      name: cheriot_mem_sys_cms_tbre_epoch
      uvm_test_seq: cheriot_mem_sys_cms_vseq
      build_mode: cms_map
      run_opts: ["+en_scb=0", "+cheriot_mem_sys_cmodel=1", "+cms_test=cms_tbre_epoch"]
      reseed: 3
    }
    {
      name: cheriot_mem_sys_cms_tbre_intr
      uvm_test_seq: cheriot_mem_sys_cms_vseq
      build_mode: cms_map
      run_opts: ["+en_scb=0", "+cheriot_mem_sys_cmodel=1", "+cms_test=cms_tbre_intr"]
      reseed: 3
    }
    // Constrained-random traffic on every port against the C reference model (testpoint
    // cmodel_random): the model scoreboard is the checker (the RAL scoreboard covers `regs` only).
    {
      name: cheriot_mem_sys_cmodel_random
      uvm_test_seq: cheriot_mem_sys_cmodel_random_vseq
      run_opts: ["+en_scb=0", "+cheriot_mem_sys_cmodel=1"]
      reseed: 10
    }
    // The model's check shown to fail: the 50th compared read reaches the model with one bit
    // flipped, and the test must fail with its mismatch (testpoint cmodel_random_inject_fail).
    {
      name: cheriot_mem_sys_cmodel_random_inject_fail
      uvm_test_seq: cheriot_mem_sys_cmodel_random_vseq
      run_opts: ["+en_scb=0", "+cheriot_mem_sys_cmodel=1", "+cheriot_mem_sys_cmodel_corrupt=50"]
      reseed: 1
    }
  ]

  // List of regressions.
  regressions: [
    {
      name: smoke
      tests: ["cheriot_mem_sys_smoke"]
    }
    {
      name: cms
      tests: ["cheriot_mem_sys_cms_smoke", "cheriot_mem_sys_cms_tag_store_load", "cheriot_mem_sys_cms_tag_clear_subword", "cheriot_mem_sys_cms_cap_load_hint", "cheriot_mem_sys_cms_access_check", "cheriot_mem_sys_cms_mode_gating", "cheriot_mem_sys_cms_rmw_same_word", "cheriot_mem_sys_cms_rmw_core_tbre_same_word", "cheriot_mem_sys_cms_tbre_sweep", "cheriot_mem_sys_cms_tbre_base_decode", "cheriot_mem_sys_cms_tbre_csr", "cheriot_mem_sys_cms_tbre_concurrent", "cheriot_mem_sys_cms_tbre_snoop_window", "cheriot_mem_sys_cms_random", "cheriot_mem_sys_cms_alert_test", "cheriot_mem_sys_cms_err_csr_intg", "cheriot_mem_sys_cms_err_data_path", "cheriot_mem_sys_cms_err_meta_intg", "cheriot_mem_sys_cms_err_tag_path", "cheriot_mem_sys_cms_err_tbre_read", "cheriot_mem_sys_cms_err_tbre_revbm", "cheriot_mem_sys_cms_nvm_cap_store", "cheriot_mem_sys_cms_tbre_epoch", "cheriot_mem_sys_cms_tbre_intr"]
    }
  ]
}
