name: "lowrisc:dv:cheriot_mem_sys_test:0.1"
description: "CHERIOT_MEM_SYS DV UVM test"
filesets:
  files_dv:
    depend:
      - lowrisc:dv:cheriot_mem_sys_env
    files:
      - cheriot_mem_sys_test_pkg.sv
      - cheriot_mem_sys_base_test.sv: {is_include_file: true}
      - cheriot_mem_sys_access_check_test.sv: {is_include_file: true}
      - cheriot_mem_sys_alert_test_reg_test.sv: {is_include_file: true}
      - cheriot_mem_sys_cap_load_hint_test.sv: {is_include_file: true}
      - cheriot_mem_sys_cmodel_random_test.sv: {is_include_file: true}
      - cheriot_mem_sys_err_csr_intg_test.sv: {is_include_file: true}
      - cheriot_mem_sys_err_data_path_test.sv: {is_include_file: true}
      - cheriot_mem_sys_err_meta_intg_test.sv: {is_include_file: true}
      - cheriot_mem_sys_err_tag_path_test.sv: {is_include_file: true}
      - cheriot_mem_sys_err_tbre_read_test.sv: {is_include_file: true}
      - cheriot_mem_sys_err_tbre_revbm_test.sv: {is_include_file: true}
      - cheriot_mem_sys_mixed_random_test.sv: {is_include_file: true}
      - cheriot_mem_sys_mode_gating_test.sv: {is_include_file: true}
      - cheriot_mem_sys_nvm_cap_store_test.sv: {is_include_file: true}
      - cheriot_mem_sys_rmw_core_tbre_same_word_test.sv: {is_include_file: true}
      - cheriot_mem_sys_rmw_same_word_test.sv: {is_include_file: true}
      - cheriot_mem_sys_tag_clear_subword_test.sv: {is_include_file: true}
      - cheriot_mem_sys_tag_smoke_test.sv: {is_include_file: true}
      - cheriot_mem_sys_tag_store_load_test.sv: {is_include_file: true}
      - cheriot_mem_sys_tbre_base_decode_test.sv: {is_include_file: true}
      - cheriot_mem_sys_tbre_concurrent_test.sv: {is_include_file: true}
      - cheriot_mem_sys_tbre_csr_test.sv: {is_include_file: true}
      - cheriot_mem_sys_tbre_epoch_test.sv: {is_include_file: true}
      - cheriot_mem_sys_tbre_intr_test.sv: {is_include_file: true}
      - cheriot_mem_sys_tbre_snoop_window_test.sv: {is_include_file: true}
      - cheriot_mem_sys_tbre_sweep_test.sv: {is_include_file: true}
    file_type: systemVerilogSource

targets:
  default:
    filesets:
      - files_dv
