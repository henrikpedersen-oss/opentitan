name: "lowrisc:dv:cheriot_mem_sys_cmodel:0.1"
description: "Shared CHERIoT memory subsystem C++ reference model and DPI package (dv/cmodel)"

filesets:
  files_dv:
    files:
      - cms_core.h: { file_type: cppSource, is_include_file: true }
      - cms_cap.h: { file_type: cppSource, is_include_file: true }
      - cms_dpi.cc: { file_type: cppSource }
      - cms_cmodel_pkg.sv: { file_type: systemVerilogSource }

targets:
  default:
    filesets:
      - files_dv
