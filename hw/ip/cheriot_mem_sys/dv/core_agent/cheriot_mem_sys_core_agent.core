name: "lowrisc:dv:cheriot_mem_sys_core_agent:0.1"
description: "The core on the CHERIoT memory subsystem's data port: TL-UL with the tag sideband"
filesets:
  files_dv:
    depend:
      - lowrisc:dv:dv_utils
      - lowrisc:dv:dv_base_agent
      - lowrisc:tlul:headers
      - lowrisc:prim:mubi_pkg
    files:
      - cheriot_mem_sys_core_if.sv
      - cheriot_mem_sys_core_agent_pkg.sv
      - cheriot_mem_sys_core_item.sv: {is_include_file: true}
      - cheriot_mem_sys_core_agent_cfg.sv: {is_include_file: true}
      - cheriot_mem_sys_core_driver.sv: {is_include_file: true}
      - cheriot_mem_sys_core_monitor.sv: {is_include_file: true}
      - cheriot_mem_sys_core_agent.sv: {is_include_file: true}
      - cheriot_mem_sys_core_access_seq.sv: {is_include_file: true}
    file_type: systemVerilogSource

targets:
  default:
    filesets:
      - files_dv
